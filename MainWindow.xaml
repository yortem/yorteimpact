<Window x:Class="YorteImpact.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:YorteImpact.Models"
        xmlns:controls="clr-namespace:YorteImpact.Controls"
        Title="YorteImpact" Width="1400" Height="880"
        Icon="pack://application:,,,/favicon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#080A11" Foreground="#E6EEF6" FontSize="11.5"
        PreviewKeyDown="Window_PreviewKeyDown">

  <Window.Resources>
    <!-- ===== palette ===== -->
    <Color x:Key="AccentColor">#2E9BFF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <LinearGradientBrush x:Key="AccentGlossBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#5CB4FF" Offset="0"/>
      <GradientStop Color="#2E9BFF" Offset="0.55"/>
      <GradientStop Color="#1F84E0" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="IconBrush" Color="#E6EEF6"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8EA0B4"/>

    <!-- ===== element templates (View for Model types) ===== -->
    <DataTemplate DataType="{x:Type models:ShapeElement}">
      <Border Width="{Binding Width}" Height="{Binding Height}"
              CornerRadius="{Binding CornerRadius}"
              Opacity="{Binding OpacityFactor}"
              OpacityMask="{Binding OpacityMaskBrush}"
              Effect="{Binding ShadowEffect}"
              Background="{Binding FillBrush}"
              BorderBrush="{Binding BorderBrush}"
              BorderThickness="{Binding StrokeThickness}"
              RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
          <TransformGroup>
            <ScaleTransform ScaleX="{Binding FlipScaleX}" ScaleY="{Binding FlipScaleY}"/>
            <RotateTransform Angle="{Binding RotationAngle}"/>
          </TransformGroup>
        </Border.RenderTransform>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type models:ImageElement}">
      <Border Width="{Binding Width}" Height="{Binding Height}"
              CornerRadius="{Binding CornerRadius}"
              Opacity="{Binding OpacityFactor}"
              OpacityMask="{Binding OpacityMaskBrush}"
              Effect="{Binding ShadowEffect}"
              Background="{Binding ImageBrush}"
              BorderBrush="#00000000" BorderThickness="0"
              RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
          <TransformGroup>
            <ScaleTransform ScaleX="{Binding FlipScaleX}" ScaleY="{Binding FlipScaleY}"/>
            <RotateTransform Angle="{Binding RotationAngle}"/>
          </TransformGroup>
        </Border.RenderTransform>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type models:TextElement}">
      <Border Width="{Binding Width}" Height="{Binding Height}"
              Background="Transparent"
              Opacity="{Binding OpacityFactor}"
              OpacityMask="{Binding OpacityMaskBrush}"
              Effect="{Binding ShadowEffect}"
              RenderTransformOrigin="0.5,0.5">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsEditing}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Border.RenderTransform>
          <TransformGroup>
            <ScaleTransform ScaleX="{Binding FlipScaleX}" ScaleY="{Binding FlipScaleY}"/>
            <RotateTransform Angle="{Binding RotationAngle}"/>
          </TransformGroup>
        </Border.RenderTransform>
        <Grid>
          <TextBlock Text="{Binding Text}"
                     FontFamily="{Binding FontFamilyValue}"
                     FontSize="{Binding FontSize}"
                     FontWeight="{Binding FontWeight}"
                     FontStyle="{Binding FontStyle}"
                     Foreground="{Binding ForegroundBrush}"
                     FlowDirection="{Binding FlowDirectionValue}"
                     TextAlignment="{Binding LogicalAlignment}"
                     TextWrapping="{Binding Wrapping}"
                     LineHeight="{Binding LineHeight}"
                     LineStackingStrategy="BlockLineHeight"
                     TextDecorations="{Binding Decorations}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding UseSimpleRender}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <controls:TextElementView Element="{Binding}">
            <controls:TextElementView.Style>
              <Style TargetType="controls:TextElementView">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding UseSimpleRender}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </controls:TextElementView.Style>
          </controls:TextElementView>
        </Grid>
      </Border>
    </DataTemplate>

    <Style x:Key="ElementContainerStyle" TargetType="ContentPresenter">
      <Setter Property="Canvas.Left" Value="{Binding X}"/>
      <Setter Property="Canvas.Top" Value="{Binding Y}"/>
      <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
    </Style>

    <!-- ===== left-rail tool buttons (narrow sidebar tool strip) ===== -->
    <Style x:Key="SideTool" TargetType="ToggleButton">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="0,2"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E6EEF6"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentPresenter.LayoutTransform>
                  <ScaleTransform ScaleX="0.78" ScaleY="0.78"/>
                </ContentPresenter.LayoutTransform>
              </ContentPresenter>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#16202D"/>
        </Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentGlossBrush}"/>
          <Setter Property="Foreground" Value="White"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
        </Trigger>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="IsChecked" Value="True"/>
            <Condition Property="IsMouseOver" Value="True"/>
          </MultiTrigger.Conditions>
          <Setter Property="Background" Value="#4FB3FF"/>
        </MultiTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SideBtn" TargetType="Button">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="0,2"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E6EEF6"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentPresenter.LayoutTransform>
                  <ScaleTransform ScaleX="0.78" ScaleY="0.78"/>
                </ContentPresenter.LayoutTransform>
              </ContentPresenter>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#16202D"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- attribute-toolbar (tool settings row) buttons -->
    <Style x:Key="AttrBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="2,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#16202D"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="AttrLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="6,0,4,0"/>
    </Style>

    <!-- attribute-toolbar building blocks -->
    <Style x:Key="AttrGroup" TargetType="Border">
      <Setter Property="Background" Value="#111A27"/><Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="AttrSep" TargetType="Border">
      <Setter Property="Width" Value="1"/><Setter Property="Background" Value="#1A2636"/>
      <Setter Property="Margin" Value="2,8,10,8"/>
    </Style>
    <Style x:Key="AttrSpin" TargetType="TextBox">
      <Setter Property="Width" Value="38"/><Setter Property="Background" Value="#0B121B"/>
      <Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#223248"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="4,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="AttrSpinBtn" TargetType="RepeatButton">
      <Setter Property="Width" Value="14"/><Setter Property="Height" Value="11"/>
      <Setter Property="Background" Value="#0E1620"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,1"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="{TemplateBinding Background}" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#223248"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="AttrCaption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#AEBCCC"/><Setter Property="FontSize" Value="10.5"/>
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- ===== top bar buttons ===== -->
    <Style x:Key="TopBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#16202D"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- segmented button groups (B/I/U/S, align, fill mode) -->
    <Style x:Key="SegGroup" TargetType="Border">
      <Setter Property="Background" Value="#0B121B"/>
      <Setter Property="BorderBrush" Value="#223248"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="SegBtn" TargetType="ToggleButton">
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="26"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="1,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentGlossBrush}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SegRadio" TargetType="RadioButton">
      <Setter Property="Padding" Value="10,0"/><Setter Property="Height" Value="26"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="1,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentGlossBrush}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- modern switch instead of a system checkbox -->
    <Style x:Key="DarkSwitch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="Track" Width="30" Height="16" CornerRadius="8" Background="#223248">
                <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="#8EA0B4"
                         HorizontalAlignment="Left" Margin="2,0,0,0"/>
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#2A3B52"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#2E9BFF"/>
                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- collapsible "extra settings" header -->
    <Style x:Key="ExtraHeader" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#C7D6E6"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid Background="Transparent" Height="24">
              <ContentPresenter ContentSource="Content" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
              <Path x:Name="Chev" Data="M0,0 L4,4 L8,0" Stroke="{TemplateBinding Foreground}"
                    StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <RotateTransform Angle="0"/>
                </Path.RenderTransform>
              </Path>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="#E6EEF6"/>
                <Setter TargetName="Chev" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="180"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- inspector card titles are brighter than field labels / values -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#C7D6E6"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource TopBtn}">
      <Setter Property="Background" Value="{StaticResource AccentGlossBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="TopToggle" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#16202D"/>
        </Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentGlossBrush}"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="GroupLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="8.5"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,8,0,4"/>
    </Style>
    <Style x:Key="RailDivider" TargetType="Border">
      <Setter Property="Width" Value="22"/><Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="#1A2636"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,7,0,7"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="10"/><Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="DarkBox" TargetType="TextBox">
      <Setter Property="Background" Value="#05080E"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}" CornerRadius="3" Margin="2,1">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#17304F"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FontComboItem" TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}">
      <EventSetter Event="MouseEnter" Handler="FontItem_MouseEnter"/>
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FontItem_Clicked"/>
    </Style>

    <Style x:Key="DarkCombo" TargetType="ComboBox">
      <Setter Property="Background" Value="#0E1620"/>
      <Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="BorderBrush" Value="#223248"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="MaxDropDownHeight" Value="280"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                            Background="{TemplateBinding Background}"
                            Foreground="{TemplateBinding Foreground}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition/>
                          <ColumnDefinition Width="22"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Margin="8,5" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Path Grid.Column="1" Data="M0,0 L4,4 L8,0"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="#2E9BFF"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                  VerticalAlignment="Center"/>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                     Focusable="False" PopupAnimation="Fade" StaysOpen="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border Background="#0B121B" BorderBrush="#223248" BorderThickness="1"
                        CornerRadius="4" Margin="0,2,0,0"
                        MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="#2E9BFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="#0D131D"/>
      <Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="BorderBrush" Value="#223248"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5" Padding="{TemplateBinding Padding}">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="8,6" Margin="1,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <ContentPresenter ContentSource="Icon" Width="14" Height="14"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Path x:Name="Check" Data="M1,7 L5,11 L12,3"
                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"
                      Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                  RecognizesAccessKey="True" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- thin dark scrollbar (inspector + every dark scroll area) -->
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="#2A3B52" CornerRadius="4" Margin="1,3"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3E5A7A"/>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2E9BFF"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="8"/>
          <Setter Property="MinHeight" Value="8"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                  <Track x:Name="PART_Track" Orientation="Horizontal">
                    <Track.Thumb>
                      <Thumb>
                        <Thumb.Template>
                          <ControlTemplate TargetType="Thumb">
                            <Border x:Name="Bd" Background="#2A3B52" CornerRadius="4" Margin="3,1"/>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E5A7A"/>
                              </Trigger>
                              <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E9BFF"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Thumb.Template>
                      </Thumb>
                    </Track.Thumb>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- ================= TOP BAR ================= -->
    <Border DockPanel.Dock="Top" Background="#0D131D" BorderBrush="#1A2636" BorderThickness="0,0,0,1">
      <Grid Height="44">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- logo + title -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,4,0">
          <Border Width="26" Height="26" CornerRadius="4" Background="{StaticResource AccentGlossBrush}"
                  VerticalAlignment="Center">
            <Path Data="M12,4 L20,9 L12,14 L4,9 Z M6.5,12.5 L12,15.5 L17.5,12.5 M6.5,16 L12,19 L17.5,16"
                  Stroke="White" StrokeThickness="1.8" Fill="Transparent"
                  Width="15" Height="15" Stretch="Uniform"/>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="YorteImpact" FontWeight="Bold" FontSize="13"/>
            <TextBlock Text="{Binding DocumentName}" Foreground="{StaticResource MutedBrush}" FontSize="9.5"
                       Margin="12,1,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="·" Foreground="{StaticResource MutedBrush}" FontSize="9.5"
                       Margin="6,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding CanvasSizeText}" Foreground="{StaticResource MutedBrush}" FontSize="9.5"
                       Margin="6,1,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>

        <!-- file actions -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
          <Button Style="{StaticResource TopBtn}" Click="NewCanvas_Click" ToolTip="New canvas — define size in pixels (Ctrl+N)">
            <StackPanel Orientation="Horizontal">
              <Path Data="M5,3 H19 V21 H5 Z M12,8 V16 M8,12 H16" Stroke="{StaticResource IconBrush}"
                    StrokeThickness="1.8" Fill="Transparent" Width="15" Height="15" Stretch="Uniform"/>
              <TextBlock Text="New" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource TopBtn}" Click="OpenProject_Click" ToolTip="Open project (.yimpact) (Ctrl+O)">
            <StackPanel Orientation="Horizontal">
              <Path Data="M3,6 H9 L11,8 H21 V19 H3 Z" Stroke="{StaticResource IconBrush}"
                    StrokeThickness="1.8" Fill="Transparent" Width="15" Height="15" Stretch="Uniform"/>
              <TextBlock Text="Open" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource TopBtn}" Click="SaveProject_Click" ToolTip="Save — choose format in the dialog: .yimpact project, PNG, GIF or WebP (Ctrl+S). Save As: Ctrl+Shift+S">
            <StackPanel Orientation="Horizontal">
              <Path Data="M5,4 H16 L20,8 V20 H5 Z M8,4 V9 H15 V4 M8,20 V14 H16 V20"
                    Stroke="{StaticResource IconBrush}" StrokeThickness="1.7" Fill="Transparent"
                    Width="15" Height="15" Stretch="Uniform"/>
              <TextBlock Text="Save" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- zoom readout -->
        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
          <Border Background="#111A27" CornerRadius="4" Padding="5,3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource TopBtn}" Padding="7,3" Margin="0" Click="ZoomOut_Click" ToolTip="Zoom out (− / numpad −)">
                <Path Data="M5,12 H19" Stroke="{StaticResource IconBrush}" StrokeThickness="2"
                      Width="13" Height="13" Stretch="Uniform"/>
              </Button>
              <Button x:Name="ZoomLabelBtn" Style="{StaticResource TopBtn}" Padding="7,3" Margin="0"
                      Click="ZoomReset_Click" ToolTip="Reset zoom to 100% (Ctrl+0)" Content="100%" MinWidth="52" FontSize="10.5"/>
              <Button Style="{StaticResource TopBtn}" Padding="7,3" Margin="0" Click="ZoomIn_Click" ToolTip="Zoom in (+ / numpad +)">
                <Path Data="M12,5 V19 M5,12 H19" Stroke="{StaticResource IconBrush}" StrokeThickness="2"
                      Width="13" Height="13" Stretch="Uniform"/>
              </Button>
            </StackPanel>
          </Border>
          <Button Style="{StaticResource TopBtn}" Padding="7,3" Margin="8,0,0,0"
                  Click="Settings_Click" ToolTip="Settings (Ctrl+,) — default canvas size">
            <Path Data="M12,8.5 A3.5,3.5 0 1,1 11.99,8.5 M12,2 V4.5 M12,19.5 V22 M2,12 H4.5 M19.5,12 H22 M4.9,4.9 L6.7,6.7 M17.3,17.3 L19.1,19.1 M19.1,4.9 L17.3,6.7 M6.7,17.3 L4.9,19.1"
                  Stroke="{StaticResource IconBrush}" StrokeThickness="1.7" Fill="Transparent"
                  Width="15" Height="15" Stretch="Uniform"/>
          </Button>
        </StackPanel>

      </Grid>
    </Border>

    <!-- ================= ATTRIBUTE TOOLBAR (tool settings row) ================= -->
    <Border DockPanel.Dock="Top" Background="#0B1018" BorderBrush="#1A2636" BorderThickness="0,0,0,1">
      <Grid Height="36">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="AttrToolName" Text="PICK" FontWeight="Bold" FontSize="10"
                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="14,0,14,0"/>

        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <Grid>
            <!-- Pick tool settings: object properties (guide pp.97-104) -->
            <StackPanel x:Name="AttrPickPanel" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,12,0" Visibility="Collapsed">
              <controls:ValueSlider Decimals="0" x:Name="AttrOpacity" Caption="Transparency" Suffix="%"
                                    Minimum="0" Maximum="100" Margin="0,0,16,0"
                                    ValueChanged="AttrOpacity_ValueChanged"/>

              <controls:ValueSlider Decimals="0" x:Name="AttrCorner" Caption="Corner" Suffix="px"
                                    Minimum="0" Maximum="250" Margin="0,0,16,0"
                                    ValueChanged="AttrCorner_ValueChanged"/>

              <controls:ValueSlider Decimals="0" x:Name="AttrSoft" Caption="Soft edge" Suffix="%"
                                    Minimum="0" Maximum="100" Margin="0,0,8,0"
                                    ValueChanged="AttrSoft_ValueChanged"/>

              <Border Style="{StaticResource AttrSep}"/>
              <TextBlock Text="ORDER" Style="{StaticResource AttrLabel}"/>
              <Button Style="{StaticResource AttrBtn}" Click="BringFront_Click" ToolTip="Bring to front (top level)">
                <Path Data="M6,12 L12,6 L18,12 M6,17 L12,11 L18,17" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="1.9" Fill="Transparent" Width="15" Height="15" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource AttrBtn}" Click="BringFwd_Click" ToolTip="Bring forward (up one level)">
                <Path Data="M6,14 L12,8 L18,14" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="2" Fill="Transparent" Width="15" Height="15" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource AttrBtn}" Click="SendBwd_Click" ToolTip="Send backward (down one level)">
                <Path Data="M6,10 L12,16 L18,10" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="2" Fill="Transparent" Width="15" Height="15" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource AttrBtn}" Click="SendBack_Click" ToolTip="Send to back (bottom level)">
                <Path Data="M6,7 L12,13 L18,7 M6,12 L12,18 L18,12" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="1.9" Fill="Transparent" Width="15" Height="15" Stretch="Uniform"/>
              </Button>

              <Border Style="{StaticResource AttrSep}"/>
              <TextBlock Text="ALIGN" Style="{StaticResource AttrLabel}"/>
              <Button Style="{StaticResource AttrBtn}" Tag="L" Click="AlignToCanvas_Click" ToolTip="Align left edge to the canvas">
                <Path Data="M3,3 V15 M6,6 H15 M6,12 H12" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="1.6" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource AttrBtn}" Tag="H" Click="AlignToCanvas_Click" ToolTip="Align horizontal center to the canvas">
                <Path Data="M9,3 V15 M4,6 H14 M6,12 H12" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="1.6" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource AttrBtn}" Tag="R" Click="AlignToCanvas_Click" ToolTip="Align right edge to the canvas">
                <Path Data="M15,3 V15 M3,6 H12 M6,12 H12" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="1.6" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource AttrBtn}" Tag="T" Click="AlignToCanvas_Click" ToolTip="Align top edge to the canvas">
                <Path Data="M3,3 H15 M6,6 V15 M12,6 V12" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="1.6" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource AttrBtn}" Tag="V" Click="AlignToCanvas_Click" ToolTip="Align vertical center to the canvas">
                <Path Data="M3,9 H15 M6,4 V14 M12,6 V12" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="1.6" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource AttrBtn}" Tag="B" Click="AlignToCanvas_Click" ToolTip="Align bottom edge to the canvas">
                <Path Data="M3,15 H15 M6,3 V12 M12,6 V12" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="1.6" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource AttrBtn}" Tag="C" Click="AlignToCanvas_Click" ToolTip="Center on the canvas (horizontal + vertical)">
                <Path Data="M3,3 H15 V15 H3 Z M9,6 V12 M6,9 H12" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="1.6" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
              </Button>

              <Border Style="{StaticResource AttrSep}"/>
              <TextBlock Text="FLIP" Style="{StaticResource AttrLabel}"/>
              <Button Style="{StaticResource AttrBtn}" Click="FlipH_Click" ToolTip="Flip horizontal">
                <Path Data="M9,5 L4,12 L9,19 M15,5 L20,12 L15,19 M12,4 V20"
                      Stroke="{StaticResource IconBrush}" StrokeThickness="1.7" Fill="Transparent"
                      Width="15" Height="15" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource AttrBtn}" Click="FlipV_Click" ToolTip="Flip vertical">
                <Path Data="M5,9 L12,4 L19,9 M5,15 L12,20 L19,15 M4,12 H20"
                      Stroke="{StaticResource IconBrush}" StrokeThickness="1.7" Fill="Transparent"
                      Width="15" Height="15" Stretch="Uniform"/>
              </Button>
            </StackPanel>

            <!-- Slice tool settings -->
            <StackPanel x:Name="AttrSlicePanel" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,12,0" Visibility="Collapsed">
              <ToggleButton x:Name="TopAddSliceBtn" Style="{StaticResource TopToggle}"
                            Click="SliceAdd_Click" ToolTip="Add slices instead of replacing">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M12,5 V19 M5,12 H19" Stroke="{StaticResource IconBrush}" StrokeThickness="2"
                        Width="14" Height="14" Stretch="Uniform"/>
                  <TextBlock Text="Add slice" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </ToggleButton>
              <TextBlock Text="Each drag replaces the slice by default — turn this on to keep several."
                         Style="{StaticResource AttrCaption}" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- Background remover settings -->
            <StackPanel x:Name="AttrErasePanel" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,12,0" Visibility="Collapsed">
              <controls:ValueSlider Decimals="0" x:Name="AttrEraseTolerance" Caption="Tolerance" Suffix="%"
                                    Minimum="0" Maximum="100" Margin="0,0,16,0"/>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <ToggleButton x:Name="AttrEraseContiguous" Style="{StaticResource TopToggle}"
                              IsChecked="True" ToolTip="Erase only the connected color region (off = every matching pixel in the image)">
                  <TextBlock Text="Contiguous" VerticalAlignment="Center"/>
                </ToggleButton>
                <Button Style="{StaticResource AttrBtn}" Click="AttrEraseAuto_Click" Margin="7,0,0,0"
                        ToolTip="Erase the background connected to the image border">
                  <TextBlock Text="Auto"/>
                </Button>
              </StackPanel>
              <TextBlock Text="Click an image to erase the color under the cursor; Auto removes the border background."
                         Style="{StaticResource AttrCaption}" Margin="4,0,0,0"/>
            </StackPanel>

            <!-- other tools: hint -->
            <TextBlock x:Name="AttrHint" VerticalAlignment="Center" Margin="4,0,10,0"
                       Foreground="#AEBCCC" FontSize="10" TextWrapping="NoWrap"/>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- ================= STATUS BAR ================= -->
    <StatusBar DockPanel.Dock="Bottom" MinHeight="26" Background="#0D131D" Foreground="#8EA0B4">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="Pick tool: click to select, drag to move. Ctrl+V pastes an image."/>
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="ZoomStatusText" Text="100%" Margin="0,0,14,0"/>
          <TextBlock x:Name="SelectionText" Text="Nothing selected"/>
        </StackPanel>
      </StatusBarItem>
    </StatusBar>

    <!-- ================= LEFT SIDEBAR (narrow tool strip) ================= -->
    <Border DockPanel.Dock="Left" Width="44" Background="#0D131D"
            BorderBrush="#1A2636" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,6,0,0">
          <!-- fa-arrow-pointer -->
          <ToggleButton x:Name="SidePickBtn" Style="{StaticResource SideTool}" IsChecked="True"
                        Click="ToolPick_Click" ToolTip="Pick tool (V)">
            <Path Data="M7,3 L20,12.5 L13,13.5 L10,21 Z" Fill="{StaticResource IconBrush}"
                  Width="20" Height="20" Stretch="Uniform"/>
          </ToggleButton>
          <!-- fa-crop-simple -->
          <ToggleButton x:Name="SideSliceBtn" Style="{StaticResource SideTool}"
                        Click="ToolSlice_Click" ToolTip="Slice tool (M) — drag a dashed region">
            <Path Data="M4,9 V4 H9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15"
                  Stroke="{StaticResource IconBrush}" StrokeThickness="2" Fill="Transparent"
                  Width="20" Height="20" Stretch="Uniform"/>
          </ToggleButton>
          <!-- background remover (magic wand) -->
          <ToggleButton x:Name="SideEraseBtn" Style="{StaticResource SideTool}"
                        Click="ToolErase_Click" ToolTip="Background remover (E) — click an image to erase a color, or Auto to erase the border background">
            <Path Data="M4,20 L13,11 M12.2,3.6 L13.6,7 L17,8.4 L13.6,9.8 L12.2,13.2 L10.8,9.8 L7.4,8.4 L10.8,7 Z"
                  Stroke="{StaticResource IconBrush}" StrokeThickness="1.8" Fill="Transparent"
                  StrokeLineJoin="Round" Width="20" Height="20" Stretch="Uniform"/>
          </ToggleButton>

          <Border Style="{StaticResource RailDivider}"/>
          <!-- fa-square : rectangle draw tool -->
          <ToggleButton x:Name="SideRectBtn" Style="{StaticResource SideTool}"
                        Click="ToolRect_Click" ToolTip="Rectangle (R) — drag on the canvas to draw">
            <Path Data="M5,6 H19 V18 H5 Z" Stroke="{StaticResource IconBrush}"
                  StrokeThickness="2" Fill="Transparent" Width="19" Height="19" Stretch="Uniform"/>
          </ToggleButton>
          <!-- text tool -->
          <ToggleButton x:Name="SideTextBtn" Style="{StaticResource SideTool}"
                        Click="ToolText_Click" ToolTip="Text (T) — click the canvas and type; RTL supported">
            <Path Data="M4,5 H20 M12,5 V20" Stroke="{StaticResource IconBrush}"
                  StrokeThickness="2" Fill="Transparent" Width="20" Height="20" Stretch="Uniform"/>
          </ToggleButton>

          <Border Style="{StaticResource RailDivider}"/>
          <!-- undo / redo -->
          <Button x:Name="BtnUndo" Style="{StaticResource SideBtn}" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)">
            <Path Data="M9,14 L4,9 L9,4 M4,9 H15 a6,6 0 0,1 0,12 H11" Stroke="{StaticResource IconBrush}"
                  StrokeThickness="1.8" Fill="Transparent" Width="19" Height="19" Stretch="Uniform"/>
          </Button>
          <Button x:Name="BtnRedo" Style="{StaticResource SideBtn}" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)">
            <Path Data="M15,14 L20,9 L15,4 M20,9 H9 a6,6 0 0,0 0,12 H13" Stroke="{StaticResource IconBrush}"
                  StrokeThickness="1.8" Fill="Transparent" Width="19" Height="19" Stretch="Uniform"/>
          </Button>
          <!-- fa-copy : duplicate -->
          <Button Style="{StaticResource SideBtn}" Click="Duplicate_Click" ToolTip="Duplicate (Ctrl+D)">
            <Path Data="M9,9 H20 V20 H9 Z M4,4 H15 V15" Stroke="{StaticResource IconBrush}"
                  StrokeThickness="1.8" Fill="Transparent" Width="19" Height="19" Stretch="Uniform"/>
          </Button>
          <!-- fa-trash-can : delete (respects slice) -->
          <Button Style="{StaticResource SideBtn}" Click="Delete_Click" ToolTip="Delete (Del) — cuts the slice area out of the selection">
            <Path Data="M6,7 H18 M10,7 V5 H14 V7 M7,7 L8,20 H16 L17,7 M10.5,11 V16 M13.5,11 V16"
                  Stroke="{StaticResource IconBrush}" StrokeThickness="1.7" Fill="Transparent"
                  Width="19" Height="19" Stretch="Uniform"/>
          </Button>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10">
          <Border Style="{StaticResource RailDivider}"/>
          <!-- eyedropper : sits right above the working-color well -->
          <ToggleButton x:Name="SideEyeBtn" Style="{StaticResource SideTool}"
                        Click="ToolEye_Click" ToolTip="Eyedropper (I) — sample a color anywhere, sets the project primary">
            <Grid Width="22" Height="22">
              <Path Data="M3.6,20.4 L13.2,10.8" Stroke="#8ED0FF" StrokeThickness="4.4"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Path Data="M13.2,8.0 L16.8,11.6" Stroke="#AEBCCC" StrokeThickness="2.6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Ellipse Width="7.6" Height="7.6" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="12.8,1.0,0,0" Fill="#E6EEF6"/>
            </Grid>
          </ToggleButton>
          <Button x:Name="InkSwatch" Style="{StaticResource SideBtn}" Height="26" Background="#3B82F6"
                  Click="InkSwatch_Click" ToolTip="Working color — click to open the picker (also applies to the selected shape)"/>
          <Border Style="{StaticResource RailDivider}"/>
          <!-- fa-magnifying-glass-plus -->
          <Button Style="{StaticResource SideBtn}" Click="ZoomIn_Click" ToolTip="Zoom in (+)">
            <Grid Width="20" Height="20">
              <Ellipse Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="1,1,0,0" Stroke="{StaticResource IconBrush}" StrokeThickness="1.8"/>
              <Path Data="M11,11 L18,18" Stroke="{StaticResource IconBrush}" StrokeThickness="1.8"/>
              <Path Data="M5,7.5 H10.5 M7.75,5 V10" Stroke="{StaticResource IconBrush}" StrokeThickness="1.6"/>
            </Grid>
          </Button>
          <!-- fa-magnifying-glass-minus -->
          <Button Style="{StaticResource SideBtn}" Click="ZoomOut_Click" ToolTip="Zoom out (−)">
            <Grid Width="20" Height="20">
              <Ellipse Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="1,1,0,0" Stroke="{StaticResource IconBrush}" StrokeThickness="1.8"/>
              <Path Data="M11,11 L18,18" Stroke="{StaticResource IconBrush}" StrokeThickness="1.8"/>
              <Path Data="M5,7.5 H10.5" Stroke="{StaticResource IconBrush}" StrokeThickness="1.6"/>
            </Grid>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ================= RIGHT INSPECTOR ================= -->
    <Border x:Name="InspectorBorder" DockPanel.Dock="Right" Width="260" Background="#0D131D" BorderBrush="#1A2636" BorderThickness="1,0,0,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel x:Name="InspectorPanel">
          <TextBlock Text="INSPECTOR" Style="{StaticResource SectionHeader}" Margin="2,2,2,8"/>
          <Border Background="#111A27" CornerRadius="5" Padding="11" x:Name="GeometryCard">
            <StackPanel>
              <TextBlock Text="GEOMETRY" Style="{StaticResource SectionHeader}"/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="X" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                <controls:ValueSlider Grid.Column="1" Compact="True" Decimals="0" x:Name="InspX" Suffix="px"
                                      Minimum="-4000" Maximum="8000" ValueChanged="InspX_ValueChanged"/>
                <TextBlock Grid.Column="3" Text="Y" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                <controls:ValueSlider Grid.Column="4" Compact="True" Decimals="0" x:Name="InspY" Suffix="px"
                                      Minimum="-4000" Maximum="8000" ValueChanged="InspY_ValueChanged"/>
              </Grid>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="W" ToolTip="Width" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                <controls:ValueSlider Grid.Column="1" Compact="True" Decimals="0" x:Name="InspW" Suffix="px"
                                      Minimum="1" Maximum="8000" ValueChanged="InspW_ValueChanged"/>
                <TextBlock Grid.Column="3" Text="H" ToolTip="Height" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                <controls:ValueSlider Grid.Column="4" Compact="True" Decimals="0" x:Name="InspH" Suffix="px"
                                      Minimum="1" Maximum="8000" ValueChanged="InspH_ValueChanged"/>
              </Grid>
              <Grid x:Name="InspCornerRow" Margin="0,2,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="Corner" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="InspRadius" Suffix="px"
                                      Minimum="0" Maximum="250" ValueChanged="InspRadius_ValueChanged"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="#111A27" CornerRadius="5" Padding="11" Margin="0,8,0,0" x:Name="RotationCard">
            <StackPanel>
              <TextBlock Text="ROTATION" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <controls:ValueSlider Decimals="0" x:Name="InspRot" Suffix="°"
                                      Minimum="-180" Maximum="180" ValueChanged="InspRot_ValueChanged"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                  <Button Style="{StaticResource AttrBtn}" Width="26" Height="26" Padding="0" Margin="0"
                          Click="RotateLeft90_Click" ToolTip="Rotate 90° left (counter-clockwise)">
                    <TextBlock Text="↺" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="{StaticResource IconBrush}"/>
                  </Button>
                  <Button Style="{StaticResource AttrBtn}" Width="26" Height="26" Padding="0" Margin="4,0,0,0"
                          Click="RotateRight90_Click" ToolTip="Rotate 90° right (clockwise)">
                    <TextBlock Text="↻" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="{StaticResource IconBrush}"/>
                  </Button>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Shape fill + border (visible only for ShapeElement) -->
          <Border Background="#111A27" CornerRadius="5" Padding="11" Margin="0,8,0,0" x:Name="AppearanceCard">
            <StackPanel>
              <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}"/>
              <TextBlock Text="Fill" Style="{StaticResource FieldLabel}"/>
              <Border Style="{StaticResource SegGroup}" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="FillSolidRadio" Style="{StaticResource SegRadio}" Content="Solid" Checked="FillMode_Checked"/>
                  <RadioButton x:Name="FillGradientRadio" Style="{StaticResource SegRadio}" Content="Gradient" Checked="FillMode_Checked"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="Fill1Label" Text="Color 1" Style="{StaticResource FieldLabel}"/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="Fill1Box" Style="{StaticResource TopBtn}" Padding="0" Height="26" Tag="Fill1" Click="ColorPreview_Click" ToolTip="Pick fill color 1"/>
                <TextBox x:Name="Fill1Text" Grid.Column="2" Style="{StaticResource DarkBox}" Margin="0" Tag="Fill1" TextChanged="FillText_TextChanged" ToolTip="Hex, e.g. #3B82F6"/>
              </Grid>
              <StackPanel x:Name="GradientOptions">
                <TextBlock Text="Color 2" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Button x:Name="Fill2Box" Style="{StaticResource TopBtn}" Padding="0" Height="26" Tag="Fill2" Click="ColorPreview_Click" ToolTip="Pick fill color 2"/>
                  <TextBox x:Name="Fill2Text" Grid.Column="2" Style="{StaticResource DarkBox}" Margin="0" Tag="Fill2" TextChanged="FillText_TextChanged" ToolTip="Hex, e.g. #93C5FD"/>
                </Grid>
                <TextBlock Text="Gradient type" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="GradTypeCombo" Style="{StaticResource DarkCombo}" SelectionChanged="GradTypeCombo_SelectionChanged">
                  <ComboBoxItem Content="Linear"/>
                  <ComboBoxItem Content="Radial"/>
                  <ComboBoxItem Content="Elliptical"/>
                </ComboBox>
                <Grid x:Name="GradAngleRow" Margin="0,0,0,6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="Angle" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                  <controls:ValueSlider Decimals="0" Grid.Column="1" x:Name="InspGradAngle" Suffix="°"
                                        Minimum="0" Maximum="360" ValueChanged="InspGradAngle_ValueChanged"/>
                </Grid>
              </StackPanel>
              <TextBlock Text="Border" Style="{StaticResource FieldLabel}"/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="StrokeBox" Style="{StaticResource TopBtn}" Padding="0" Height="26" Tag="Stroke" Click="ColorPreview_Click" ToolTip="Pick border color"/>
                <TextBox x:Name="StrokeText" Grid.Column="2" Style="{StaticResource DarkBox}" Margin="0" Tag="Stroke" TextChanged="FillText_TextChanged" ToolTip="Hex, e.g. #1E3A8A"/>
              </Grid>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="Thickness" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                <controls:ValueSlider Decimals="0" Grid.Column="1" x:Name="InspStrokeThick" Suffix="px"
                                      Minimum="0" Maximum="100" ValueChanged="InspStrokeThick_ValueChanged"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Font + style + alignment (visible only for TextElement) -->
          <Border Background="#111A27" CornerRadius="5" Padding="11" Margin="0,8,0,0" x:Name="TextCard">
            <StackPanel>
              <TextBlock Text="TEXT" Style="{StaticResource SectionHeader}"/>

              <TextBlock Text="Font" Style="{StaticResource FieldLabel}"/>
              <Grid Margin="0,0,0,6">
                <TextBox x:Name="TextFontSearch" Style="{StaticResource DarkBox}" Margin="0" Padding="24,5,6,5"
                         TextChanged="TextFontSearch_TextChanged" ToolTip="Search fonts by name"/>
                <Path Data="M5,5 A3.5,3.5 0 1,1 4.99,5 M7,7 L11,11" Stroke="#8EA0B4" StrokeThickness="1.5"
                      Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="6,0,0,0" IsHitTestVisible="False"/>
                <TextBlock Text="Search font…" Foreground="#6F8094" FontSize="11" Margin="26,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=TextFontSearch}" Value="">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
              <ComboBox x:Name="TextFontCombo" Style="{StaticResource DarkCombo}" IsTextSearchEnabled="True"
                        ItemContainerStyle="{StaticResource FontComboItem}"
                        DropDownOpened="TextFont_DropDownOpened"
                        DropDownClosed="TextFont_DropDownClosed"
                        PreviewKeyDown="TextFont_PreviewKeyDown"
                        SelectionChanged="TextFont_SelectionChanged"
                        ToolTip="Hover or ↑/↓ to preview; Enter applies">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="Size" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="TextSize" Suffix="px"
                                      Minimum="6" Maximum="300" ValueChanged="TextSize_ValueChanged"/>
              </Grid>

              <Border Style="{StaticResource SegGroup}" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                  <ToggleButton x:Name="TextBoldBtn" Style="{StaticResource SegBtn}" Click="TextStyle_Click" ToolTip="Bold">
                    <TextBlock Text="B" FontWeight="Bold" FontSize="13"/>
                  </ToggleButton>
                  <ToggleButton x:Name="TextItalicBtn" Style="{StaticResource SegBtn}" Click="TextStyle_Click" ToolTip="Italic">
                    <TextBlock Text="I" FontStyle="Italic" FontSize="13"/>
                  </ToggleButton>
                  <ToggleButton x:Name="TextUnderlineBtn" Style="{StaticResource SegBtn}" Click="TextStyle_Click" ToolTip="Underline">
                    <TextBlock Text="U" TextDecorations="Underline" FontSize="13"/>
                  </ToggleButton>
                  <ToggleButton x:Name="TextStrikeBtn" Style="{StaticResource SegBtn}" Click="TextStyle_Click" ToolTip="Strikethrough">
                    <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="13"/>
                  </ToggleButton>
                </StackPanel>
              </Border>

              <TextBlock Text="Align" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
              <Border Style="{StaticResource SegGroup}" Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <ToggleButton x:Name="TextAlignLeftBtn" Style="{StaticResource SegBtn}" Click="TextAlign_Click" ToolTip="Align left">
                    <Path Data="M3,5 H21 M3,10 H14 M3,15 H21 M3,20 H11" Stroke="{StaticResource IconBrush}"
                          StrokeThickness="1.7" Fill="Transparent" Width="16" Height="16" Stretch="Uniform"/>
                  </ToggleButton>
                  <ToggleButton x:Name="TextAlignCenterBtn" Style="{StaticResource SegBtn}" Click="TextAlign_Click" ToolTip="Center">
                    <Path Data="M3,5 H21 M6,10 H18 M3,15 H21 M7,20 H17" Stroke="{StaticResource IconBrush}"
                          StrokeThickness="1.7" Fill="Transparent" Width="16" Height="16" Stretch="Uniform"/>
                  </ToggleButton>
                  <ToggleButton x:Name="TextAlignRightBtn" Style="{StaticResource SegBtn}" Click="TextAlign_Click" ToolTip="Align right">
                    <Path Data="M3,5 H21 M10,10 H21 M3,15 H21 M13,20 H21" Stroke="{StaticResource IconBrush}"
                          StrokeThickness="1.7" Fill="Transparent" Width="16" Height="16" Stretch="Uniform"/>
                  </ToggleButton>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Text fill / gradient -->
          <Border Background="#111A27" CornerRadius="5" Padding="11" Margin="0,8,0,0" x:Name="TextFillCard">
            <StackPanel>
              <TextBlock Text="FILL" Style="{StaticResource SectionHeader}"/>

              <Border Style="{StaticResource SegGroup}" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="TextFillSolidRadio" Style="{StaticResource SegRadio}" Content="Solid" Checked="TextFillMode_Checked"/>
                  <RadioButton x:Name="TextFillGradientRadio" Style="{StaticResource SegRadio}" Content="Gradient" Checked="TextFillMode_Checked"/>
                </StackPanel>
              </Border>

              <TextBlock Text="Color" Style="{StaticResource FieldLabel}"/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="TextColor1Box" Style="{StaticResource TopBtn}" Padding="0" Height="26" Tag="TextFill1" Click="ColorPreview_Click" ToolTip="Pick text color"/>
                <TextBox x:Name="TextColor1Text" Grid.Column="2" Style="{StaticResource DarkBox}" Margin="0" Tag="TextFill1" TextChanged="FillText_TextChanged" ToolTip="Hex, e.g. #1E293B"/>
              </Grid>

              <StackPanel x:Name="TextGradientOptions">
                <TextBlock Text="Color 2" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Button x:Name="TextColor2Box" Style="{StaticResource TopBtn}" Padding="0" Height="26" Tag="TextFill2" Click="ColorPreview_Click" ToolTip="Pick gradient end color"/>
                  <TextBox x:Name="TextColor2Text" Grid.Column="2" Style="{StaticResource DarkBox}" Margin="0" Tag="TextFill2" TextChanged="FillText_TextChanged" ToolTip="Hex, e.g. #2E9BFF"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="Angle" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                  <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="TextGradAngle" Suffix="°"
                                        Minimum="0" Maximum="360" ValueChanged="TextGradAngle_ValueChanged"/>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Directional fade-to-transparent (collapsible) -->
          <Border Background="#111A27" CornerRadius="5" Padding="11" Margin="0,8,0,0" x:Name="TransparencyCard">
            <StackPanel>
              <ToggleButton x:Name="TransparencyToggle" Style="{StaticResource ExtraHeader}" Content="TRANSPARENCY" Click="Transparency_Click"/>
              <StackPanel x:Name="TransparencyContent" Visibility="Collapsed" Margin="0,10,0,0">
                <CheckBox x:Name="OpacityGradientCheck" Style="{StaticResource DarkSwitch}" Content="Gradient transparency"
                          Checked="OpacityGradient_Toggled" Unchecked="OpacityGradient_Toggled"/>
                <StackPanel x:Name="OpacityOptions" Visibility="Collapsed" Margin="0,8,0,0">
                  <TextBlock Text="Direction" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="OpacityDirectionCombo" Style="{StaticResource DarkCombo}" SelectionChanged="OpacityDirection_SelectionChanged">
                    <ComboBoxItem Content="Top → Bottom"/>
                    <ComboBoxItem Content="Bottom → Top"/>
                    <ComboBoxItem Content="Left → Right"/>
                    <ComboBoxItem Content="Right → Left"/>
                    <ComboBoxItem Content="Top-Left → Bottom-Right"/>
                    <ComboBoxItem Content="Top-Right → Bottom-Left"/>
                    <ComboBoxItem Content="Bottom-Left → Top-Right"/>
                    <ComboBoxItem Content="Bottom-Right → Top-Left"/>
                  </ComboBox>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="Strength" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                    <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="OpacityStrength" Suffix="%"
                                          Minimum="0" Maximum="100" ValueChanged="OpacityStrength_ValueChanged"/>
                  </Grid>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="Start" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                    <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="OpacityStart" Suffix="%"
                                          Minimum="0" Maximum="100" ValueChanged="OpacityStart_ValueChanged"/>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="End" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                    <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="OpacityEnd" Suffix="%"
                                          Minimum="0" Maximum="100" ValueChanged="OpacityEnd_ValueChanged"/>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Spacing / wrap / shadow, hidden until expanded -->
          <Border Background="#111A27" CornerRadius="5" Padding="11" Margin="0,8,0,0" x:Name="TextExtraCard">
            <StackPanel>
              <ToggleButton x:Name="TextExtraToggle" Style="{StaticResource ExtraHeader}" Content="EXTRA SETTINGS" Click="TextExtra_Click"/>
              <StackPanel x:Name="TextExtraContent" Visibility="Collapsed" Margin="0,10,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="Letter spacing" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                  <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="TextLetterSpacing" Suffix="px"
                                        Minimum="0" Maximum="50" ValueChanged="TextLetterSpacing_ValueChanged"/>
                </Grid>
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="Line spacing" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                  <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="TextLineSpacing" Suffix="%"
                                        Minimum="50" Maximum="300" ValueChanged="TextLineSpacing_ValueChanged"/>
                </Grid>

                <CheckBox x:Name="TextWrapCheck" Style="{StaticResource DarkSwitch}" Content="Limit width" Margin="0,10,0,0"
                          Checked="TextWrap_Toggled" Unchecked="TextWrap_Toggled"/>
                <Grid x:Name="TextWrapRow" Margin="0,6,0,0" Visibility="Collapsed">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="Wrap width" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                  <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="TextWrapWidth" Suffix="px"
                                        Minimum="40" Maximum="2000" ValueChanged="TextWrapWidth_ValueChanged"/>
                </Grid>

                <CheckBox x:Name="TextShadowCheck" Style="{StaticResource DarkSwitch}" Content="Drop shadow" Margin="0,10,0,0"
                          Checked="TextShadow_Toggled" Unchecked="TextShadow_Toggled"/>
                <StackPanel x:Name="TextShadowOptions" Margin="0,6,0,0">
                  <TextBlock Text="Shadow color" Style="{StaticResource FieldLabel}"/>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button x:Name="TextShadowColorBox" Style="{StaticResource TopBtn}" Padding="0" Height="26" Tag="TextShadow" Click="ColorPreview_Click" ToolTip="Pick shadow color"/>
                    <TextBox x:Name="TextShadowText" Grid.Column="2" Style="{StaticResource DarkBox}" Margin="0" Tag="TextShadow" TextChanged="FillText_TextChanged" ToolTip="Hex, e.g. #000000"/>
                  </Grid>
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="X" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                    <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="TextShadowX" Suffix="px"
                                          Minimum="-100" Maximum="100" ValueChanged="TextShadowX_ValueChanged"/>
                  </Grid>
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="Y" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                    <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="TextShadowY" Suffix="px"
                                          Minimum="-100" Maximum="100" ValueChanged="TextShadowY_ValueChanged"/>
                  </Grid>
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="Blur" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                    <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="TextShadowBlur" Suffix="px"
                                          Minimum="0" Maximum="200" ValueChanged="TextShadowBlur_ValueChanged"/>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="Opacity" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                    <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="TextShadowOpacity" Suffix="%"
                                          Minimum="0" Maximum="100" ValueChanged="TextShadowOpacity_ValueChanged"/>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Shadow (any element) -->
          <Border Background="#111A27" CornerRadius="5" Padding="11" Margin="0,8,0,0" x:Name="ShadowCard">
            <StackPanel>
              <TextBlock Text="SHADOW" Style="{StaticResource SectionHeader}"/>
              <ComboBox x:Name="ShadowTypeCombo" Style="{StaticResource DarkCombo}" SelectionChanged="ShadowType_SelectionChanged">
                <ComboBoxItem Content="None"/>
                <ComboBoxItem Content="Soft"/>
                <ComboBoxItem Content="Medium"/>
                <ComboBoxItem Content="Hard"/>
                <ComboBoxItem Content="Long"/>
                <ComboBoxItem Content="Glow"/>
                <ComboBoxItem Content="Custom"/>
              </ComboBox>

              <StackPanel x:Name="ShadowOptions" Margin="0,6,0,0">
                <TextBlock Text="Color" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Button x:Name="ShadowColorBox" Style="{StaticResource TopBtn}" Padding="0" Height="26" Tag="Shadow" Click="ColorPreview_Click" ToolTip="Pick shadow color"/>
                  <TextBox x:Name="ShadowText" Grid.Column="2" Style="{StaticResource DarkBox}" Margin="0" Tag="Shadow" TextChanged="FillText_TextChanged" ToolTip="Hex, e.g. #000000"/>
                </Grid>

                <Grid Margin="0,0,0,7">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="X" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                  <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="ShadowX" Suffix="px"
                                        Minimum="-100" Maximum="100" ValueChanged="ShadowX_ValueChanged"/>
                </Grid>
                <Grid Margin="0,0,0,7">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="Y" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                  <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="ShadowY" Suffix="px"
                                        Minimum="-100" Maximum="100" ValueChanged="ShadowY_ValueChanged"/>
                </Grid>
                <Grid Margin="0,0,0,7">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="Blur" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                  <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="ShadowBlur" Suffix="px"
                                        Minimum="0" Maximum="200" ValueChanged="ShadowBlur_ValueChanged"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="Opacity" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                  <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="ShadowOpacity" Suffix="%"
                                        Minimum="0" Maximum="100" ValueChanged="ShadowOpacity_ValueChanged"/>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Background="#111A27" CornerRadius="5" Padding="11" Margin="0,8,0,0">
            <StackPanel>
              <TextBlock Text="WORKFLOW" Style="{StaticResource SectionHeader}"/>
              <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="#AEBCCC" LineHeight="17"
                         Text="Pick (V): select/move/resize; rotate with the Rotation slider or the ↺ ↻ buttons. Slice (M): drag regions, click activates; Delete cuts; Space toggles markers; arrows nudge. Ctrl+F fill, Ctrl+Z/Y undo/redo."/>
              <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="#AEBCCC" LineHeight="17" Margin="0,8,0,0"
                         Text="Paste images with Ctrl+V or drag files in. − / + (both keyboards) or Ctrl+wheel zooms. Space clears the selection — click the element to select it again."/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- drag this edge to widen / narrow the inspector -->
    <Thumb x:Name="InspectorSplitter" DockPanel.Dock="Right" Width="5" Cursor="SizeWE"
           DragDelta="InspectorSplitter_DragDelta">
      <Thumb.Template>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="#1A2636" BorderThickness="1,0,0,0"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Thumb.Template>
    </Thumb>

    <!-- ================= VIEWPORT ================= -->
    <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  Background="#090D15" Focusable="True"
                  SizeChanged="Viewport_SizeChanged"
                  PreviewMouseWheel="Viewport_PreviewMouseWheel">
      <!-- ScrollHost is sized to the canvas (never smaller than the viewport), so
           the scroll range spans only the artboard: when the whole canvas fits at
           the current zoom there is nothing to scroll (no wheel/scrollbars). -->
      <Canvas x:Name="ScrollHost" Background="#090D15">
        <Canvas x:Name="Pasteboard" Width="{Binding PasteboardWidth}" Height="{Binding PasteboardHeight}"
              Background="#090D15"
              MouseLeftButtonDown="Pasteboard_MouseDown"
              MouseMove="Pasteboard_MouseMove"
              MouseLeftButtonUp="Pasteboard_MouseUp"
              AllowDrop="True" Drop="Pasteboard_Drop" DragOver="Pasteboard_DragOver">
        <Canvas.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Background color…" Click="CanvasBgColor_Click">
              <MenuItem.Icon>
                <Border Width="13" Height="13" CornerRadius="2" BorderThickness="1" BorderBrush="#223248">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#FF5A5A" Offset="0"/>
                      <GradientStop Color="#FFD25A" Offset="0.25"/>
                      <GradientStop Color="#6BE06B" Offset="0.5"/>
                      <GradientStop Color="#5AA8FF" Offset="0.75"/>
                      <GradientStop Color="#B07BFF" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="CanvasTransparentMenuItem" Header="Transparent background" IsCheckable="True" Click="CanvasTransparent_Click">
              <MenuItem.Icon>
                <Border Width="13" Height="13" CornerRadius="2" BorderThickness="1" BorderBrush="#223248">
                  <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
                      <DrawingBrush.Drawing>
                        <DrawingGroup>
                          <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H3 V3 H0 Z M3,3 H6 V6 H3 Z"/>
                          <GeometryDrawing Brush="#9AA8B8" Geometry="M3,0 H6 V3 H3 Z M0,3 H3 V6 H0 Z"/>
                        </DrawingGroup>
                      </DrawingBrush.Drawing>
                    </DrawingBrush>
                  </Border.Background>
                </Border>
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Canvas.ContextMenu>

        <Rectangle x:Name="Artboard"
                   Canvas.Left="{Binding ArtboardX}" Canvas.Top="{Binding ArtboardY}"
                   Width="{Binding ArtboardWidth}" Height="{Binding ArtboardHeight}"
                   Fill="White" Stroke="#8FA3B5" StrokeThickness="1">
          <!-- Cached once: the blurred shadow must NOT re-render every drag frame. -->
          <Rectangle.CacheMode>
            <BitmapCache/>
          </Rectangle.CacheMode>
          <Rectangle.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="22" ShadowDepth="5"/>
          </Rectangle.Effect>
        </Rectangle>

        <ItemsControl x:Name="ElementHost" ItemsSource="{Binding Elements}"
                      Width="{Binding PasteboardWidth}" Height="{Binding PasteboardHeight}"
                      ItemContainerStyle="{StaticResource ElementContainerStyle}">
          <!-- Elements render ONLY on the white canvas; outside parts are clipped (and don't hit-test). -->
          <ItemsControl.Clip>
            <RectangleGeometry Rect="{Binding ArtboardRect}"/>
          </ItemsControl.Clip>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas Background="Transparent" IsItemsHost="True"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <controls:SelectionOverlay x:Name="SelectionAdorner"
                                   Width="{Binding PasteboardWidth}" Height="{Binding PasteboardHeight}"
                                   IsHitTestVisible="False"/>

        <!-- Slice regions layer: all markers (active = cyan, others dim) -->
        <Canvas x:Name="SliceLayer"
                Width="{Binding PasteboardWidth}" Height="{Binding PasteboardHeight}"
                IsHitTestVisible="False"/>

        <!-- Draw preview: the real shape (fill, border, corner radius) while dragging -->
        <Rectangle x:Name="DrawRectVisual" Visibility="Collapsed"
                   Stroke="#1E6FBF" StrokeThickness="2"
                   Fill="#2E9BFF" RadiusX="14" RadiusY="14"
                   IsHitTestVisible="False">
          <Rectangle.Clip>
            <RectangleGeometry Rect="{Binding ArtboardRect}"/>
          </Rectangle.Clip>
        </Rectangle>
      </Canvas>
      </Canvas>
    </ScrollViewer>
  </DockPanel>
</Window>
