<Window x:Class="YorteImpact.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:YorteImpact.Models"
        xmlns:controls="clr-namespace:YorteImpact.Controls"
        Title="YorteImpact" Width="1400" Height="880"
        Icon="pack://application:,,,/favicon.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#080A11" Foreground="#E6EEF6" FontSize="11.5"
        PreviewKeyDown="Window_PreviewKeyDown">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- ===== palette ===== -->
    <Color x:Key="AccentColor">#2E9BFF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <LinearGradientBrush x:Key="AccentGlossBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#5CB4FF" Offset="0"/>
      <GradientStop Color="#2E9BFF" Offset="0.55"/>
      <GradientStop Color="#1F84E0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoImpactBrush" StartPoint="0,0.5" EndPoint="1,0.5">
      <GradientStop Color="#6FC7FF" Offset="0"/>
      <GradientStop Color="#2E9BFF" Offset="0.45"/>
      <GradientStop Color="#9A5CFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="IconBrush" Color="#E6EEF6"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8EA0B4"/>

    <!-- color-direction tracks for the Photo tab -->
    <LinearGradientBrush x:Key="PhotoTemperatureTrack" StartPoint="0,0.5" EndPoint="1,0.5">
      <GradientStop Color="#2E6BFF" Offset="0"/>
      <GradientStop Color="#56657A" Offset="0.5"/>
      <GradientStop Color="#FF7A45" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PhotoTintTrack" StartPoint="0,0.5" EndPoint="1,0.5">
      <GradientStop Color="#35C26B" Offset="0"/>
      <GradientStop Color="#56657A" Offset="0.5"/>
      <GradientStop Color="#C65CFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Transparent-pixel backdrop for brush previews -->
    <DrawingBrush x:Key="PreviewChecker" TileMode="Tile"
                  Viewport="0,0,6,6" ViewportUnits="Absolute" Stretch="None">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#1A2636" Geometry="M0,0 H3 V3 H0 Z M3,3 H6 V6 H3 Z"/>
          <GeometryDrawing Brush="#2A3B52" Geometry="M3,0 H6 V3 H3 Z M0,3 H3 V6 H0 Z"/>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ===== element templates (View for Model types) ===== -->
    <DataTemplate DataType="{x:Type models:ShapeElement}">
      <Border Width="{Binding Width}" Height="{Binding Height}"
              Opacity="{Binding OpacityFactor}"
              OpacityMask="{Binding OpacityMaskBrush}"
              Effect="{Binding ShadowEffect}"
              RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
          <TransformGroup>
            <ScaleTransform ScaleX="{Binding FlipScaleX}" ScaleY="{Binding FlipScaleY}"/>
            <RotateTransform Angle="{Binding RotationAngle}"/>
          </TransformGroup>
        </Border.RenderTransform>
        <Path Data="{Binding ShapeGeometry}"
              Fill="{Binding FillBrush}"
              Stroke="{Binding BorderBrush}"
              StrokeThickness="{Binding StrokeThickness}"
              StrokeLineJoin="Round" Stretch="None"
              HorizontalAlignment="Left" VerticalAlignment="Top"/>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type models:ImageElement}">
      <Border Width="{Binding Width}" Height="{Binding Height}"
              CornerRadius="{Binding CornerRadius}"
              Opacity="{Binding OpacityFactor}"
              OpacityMask="{Binding OpacityMaskBrush}"
              Effect="{Binding ShadowEffect}"
              Background="{Binding ImageBrush}"
              BorderBrush="#00000000" BorderThickness="0"
              RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
          <TransformGroup>
            <ScaleTransform ScaleX="{Binding FlipScaleX}" ScaleY="{Binding FlipScaleY}"/>
            <RotateTransform Angle="{Binding RotationAngle}"/>
          </TransformGroup>
        </Border.RenderTransform>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type models:GroupElement}">
      <Border Width="{Binding Width}" Height="{Binding Height}"
              Background="Transparent"
              Opacity="{Binding OpacityFactor}"
              OpacityMask="{Binding OpacityMaskBrush}"
              Effect="{Binding ShadowEffect}"
              RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
          <TransformGroup>
            <ScaleTransform ScaleX="{Binding FlipScaleX}" ScaleY="{Binding FlipScaleY}"/>
            <RotateTransform Angle="{Binding RotationAngle}"/>
          </TransformGroup>
        </Border.RenderTransform>
        <ItemsControl ItemsSource="{Binding Children}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Setter Property="Canvas.Left" Value="{Binding X}"/>
              <Setter Property="Canvas.Top" Value="{Binding Y}"/>
            </Style>
          </ItemsControl.ItemContainerStyle>
        </ItemsControl>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type models:PaintLayerElement}">
      <Image Width="{Binding Width}" Height="{Binding Height}"
             Source="{Binding Source}" Stretch="Fill"
             IsHitTestVisible="False"
             RenderOptions.BitmapScalingMode="HighQuality"/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type models:TextElement}">
      <Border Width="{Binding Width}" Height="{Binding Height}"
              Background="Transparent"
              Opacity="{Binding OpacityFactor}"
              OpacityMask="{Binding OpacityMaskBrush}"
              Effect="{Binding ShadowEffect}"
              RenderTransformOrigin="0.5,0.5">
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsEditing}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Border.RenderTransform>
          <TransformGroup>
            <ScaleTransform ScaleX="{Binding FlipScaleX}" ScaleY="{Binding FlipScaleY}"/>
            <RotateTransform Angle="{Binding RotationAngle}"/>
          </TransformGroup>
        </Border.RenderTransform>
        <Grid>
          <TextBlock Text="{Binding Text}"
                     FontFamily="{Binding FontFamilyValue}"
                     FontSize="{Binding FontSize}"
                     FontWeight="{Binding FontWeight}"
                     FontStyle="{Binding FontStyle}"
                     Foreground="{Binding ForegroundBrush}"
                     FlowDirection="{Binding FlowDirectionValue}"
                     TextAlignment="{Binding LogicalAlignment}"
                     TextWrapping="{Binding Wrapping}"
                     LineHeight="{Binding LineHeight}"
                     LineStackingStrategy="MaxHeight"
                     TextDecorations="{Binding Decorations}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding UseSimpleRender}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <controls:TextElementView Element="{Binding}">
            <controls:TextElementView.Style>
              <Style TargetType="controls:TextElementView">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding UseSimpleRender}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </controls:TextElementView.Style>
          </controls:TextElementView>
        </Grid>
      </Border>
    </DataTemplate>

    <Style x:Key="ElementContainerStyle" TargetType="ContentPresenter">
      <Setter Property="Canvas.Left" Value="{Binding X}"/>
      <Setter Property="Canvas.Top" Value="{Binding Y}"/>
      <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
    </Style>

    <!-- ===== left-rail tool buttons (narrow sidebar tool strip) ===== -->
    <Style x:Key="SideTool" TargetType="ToggleButton">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="0,2"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E6EEF6"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentPresenter.LayoutTransform>
                  <ScaleTransform ScaleX="0.78" ScaleY="0.78"/>
                </ContentPresenter.LayoutTransform>
              </ContentPresenter>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#16202D"/>
        </Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentGlossBrush}"/>
          <Setter Property="Foreground" Value="White"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
        </Trigger>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="IsChecked" Value="True"/>
            <Condition Property="IsMouseOver" Value="True"/>
          </MultiTrigger.Conditions>
          <Setter Property="Background" Value="#4FB3FF"/>
        </MultiTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SideBtn" TargetType="Button">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="0,2"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E6EEF6"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentPresenter.LayoutTransform>
                  <ScaleTransform ScaleX="0.78" ScaleY="0.78"/>
                </ContentPresenter.LayoutTransform>
              </ContentPresenter>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#16202D"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- attribute-toolbar (tool settings row) buttons -->
    <Style x:Key="AttrBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="2,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#16202D"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="AttrLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="6,0,4,0"/>
    </Style>

    <!-- popup list rows for brush presets (not a dropdown/select control) -->
    <Style x:Key="PresetItemBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- attribute-toolbar building blocks -->
    <Style x:Key="AttrGroup" TargetType="Border">
      <Setter Property="Background" Value="#111A27"/><Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="AttrSep" TargetType="Border">
      <Setter Property="Width" Value="1"/><Setter Property="Background" Value="#1A2636"/>
      <Setter Property="Margin" Value="2,8,10,8"/>
    </Style>
    <Style x:Key="AttrSpin" TargetType="TextBox">
      <Setter Property="Width" Value="38"/><Setter Property="Background" Value="#0B121B"/>
      <Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#223248"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="4,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="AttrSpinBtn" TargetType="RepeatButton">
      <Setter Property="Width" Value="14"/><Setter Property="Height" Value="11"/>
      <Setter Property="Background" Value="#0E1620"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,1"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="{TemplateBinding Background}" CornerRadius="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#223248"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="AttrCaption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#AEBCCC"/><Setter Property="FontSize" Value="10.5"/>
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- small color well used by the text tool bar -->
    <Style x:Key="AttrSwatch" TargetType="Button">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="BorderBrush" Value="#3A4A60"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#2E9BFF"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#2E9BFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== top bar buttons ===== -->
    <Style x:Key="TopBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#16202D"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- segmented button groups (B/I/U/S, align, fill mode) -->
    <Style x:Key="SegGroup" TargetType="Border">
      <Setter Property="Background" Value="#0B121B"/>
      <Setter Property="BorderBrush" Value="#223248"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="SegBtn" TargetType="ToggleButton">
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="26"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="1,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentGlossBrush}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SegRadio" TargetType="RadioButton">
      <Setter Property="Padding" Value="10,0"/><Setter Property="Height" Value="26"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="1,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentGlossBrush}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- modern switch instead of a system checkbox -->
    <Style x:Key="DarkSwitch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="Track" Width="30" Height="16" CornerRadius="8" Background="#223248">
                <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="#8EA0B4"
                         HorizontalAlignment="Left" Margin="2,0,0,0"/>
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#2A3B52"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#2E9BFF"/>
                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- collapsible "extra settings" header -->
    <Style x:Key="ExtraHeader" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="-11,-11,-11,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="#111A27" BorderBrush="#1A2636"
                    BorderThickness="0,0,0,1" Height="38">
              <Grid>
                <Border Width="2" HorizontalAlignment="Left" Background="#2E9BFF"/>
                <ContentPresenter ContentSource="Content" HorizontalAlignment="Left"
                                  VerticalAlignment="Center" Margin="14,0,0,0"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                <Path x:Name="Chev" Data="M0,0 L4,4 L8,0" Stroke="{TemplateBinding Foreground}"
                      StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,0,14,0" RenderTransformOrigin="0.5,0.5">
                  <Path.RenderTransform>
                    <RotateTransform Angle="0"/>
                  </Path.RenderTransform>
                </Path>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="#E6EEF6"/>
                <Setter TargetName="Chev" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="180"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- full-width header band inside a section card (the card has 11px padding) -->
    <Style x:Key="SectionBand" TargetType="Border">
      <Setter Property="Background" Value="#111A27"/>
      <Setter Property="BorderBrush" Value="#1A2636"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Margin" Value="-11,-11,-11,12"/>
    </Style>

    <!-- same band for stand-alone panel titles (no card padding) -->
    <Style x:Key="TopBand" TargetType="Border">
      <Setter Property="Background" Value="#111A27"/>
      <Setter Property="BorderBrush" Value="#1A2636"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Height" Value="38"/>
    </Style>

    <!-- inspector card titles are brighter than field labels / values -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- right panel tabs: Inspector / Photo -->
    <Style x:Key="RightTabBtn" TargetType="ToggleButton">
      <Setter Property="Height" Value="27"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#8EA0B4"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1A2636"/>
                <Setter Property="Foreground" Value="#E6EEF6"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- photo preset thumb -->
    <Style x:Key="PhotoPresetTile" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="3"/>
      <Setter Property="Margin" Value="0,0,5,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#2E9BFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ShadowPresetTile" TargetType="Button">
      <Setter Property="Background" Value="#0B121B"/>
      <Setter Property="BorderBrush" Value="#223248"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="3"/>
      <Setter Property="Margin" Value="0,0,4,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
              </Trigger>
              <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16263A"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#2E9BFF"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource TopBtn}">
      <Setter Property="Background" Value="{StaticResource AccentGlossBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="TopToggle" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" CornerRadius="4"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#16202D"/>
        </Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentGlossBrush}"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="GroupLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="8.5"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,8,0,4"/>
    </Style>
    <Style x:Key="RailDivider" TargetType="Border">
      <Setter Property="Width" Value="22"/><Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="#1A2636"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,7,0,7"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="10"/><Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="DarkBox" TargetType="TextBox">
      <Setter Property="Background" Value="#05080E"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}" CornerRadius="3" Margin="2,1">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#17304F"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FontComboItem" TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}">
      <EventSetter Event="MouseEnter" Handler="FontItem_MouseEnter"/>
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FontItem_Clicked"/>
    </Style>

    <Style x:Key="DarkCombo" TargetType="ComboBox">
      <Setter Property="Background" Value="#0E1620"/>
      <Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="BorderBrush" Value="#223248"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="MaxDropDownHeight" Value="280"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                            Background="{TemplateBinding Background}"
                            Foreground="{TemplateBinding Foreground}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition/>
                          <ColumnDefinition Width="22"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Margin="8,5" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Path Grid.Column="1" Data="M0,0 L4,4 L8,0"
                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="#2E9BFF"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                  VerticalAlignment="Center"/>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                     Focusable="False" PopupAnimation="Fade" StaysOpen="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border Background="#0B121B" BorderBrush="#223248" BorderThickness="1"
                        CornerRadius="4" Margin="0,2,0,0"
                        MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="#2E9BFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="#0D131D"/>
      <Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="BorderBrush" Value="#223248"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5" Padding="{TemplateBinding Padding}">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="8,6" Margin="1,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <ContentPresenter ContentSource="Icon" Width="14" Height="14"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Path x:Name="Check" Data="M1,7 L5,11 L12,3"
                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8"
                      Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                  RecognizesAccessKey="True" VerticalAlignment="Center"/>
                <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-4" VerticalOffset="-6"
                       IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True"
                       Focusable="False" PopupAnimation="Fade">
                  <Border Background="#0D131D" BorderBrush="#223248" BorderThickness="1"
                          CornerRadius="5" Padding="4" MaxHeight="420">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <ItemsPresenter/>
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- thin dark scrollbar (inspector + every dark scroll area) -->
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="#2A3B52" CornerRadius="4" Margin="1,3"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3E5A7A"/>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2E9BFF"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="8"/>
          <Setter Property="MinHeight" Value="8"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                  <Track x:Name="PART_Track" Orientation="Horizontal">
                    <Track.Thumb>
                      <Thumb>
                        <Thumb.Template>
                          <ControlTemplate TargetType="Thumb">
                            <Border x:Name="Bd" Background="#2A3B52" CornerRadius="4" Margin="3,1"/>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E5A7A"/>
                              </Trigger>
                              <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E9BFF"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Thumb.Template>
                      </Thumb>
                    </Track.Thumb>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ===== custom window title bar + tabs ===== -->
    <Style x:Key="TitleBarBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#C7D6E6"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#223248"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TitleBarCloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#A02518"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TabCloseBtn" TargetType="Button">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#8EA0B4"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Content" Value="✕"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#223248"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NewTabBtn" TargetType="Button">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#C7D6E6"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#223248"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="EmptyPrimaryBtn" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#4C8DFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1F84E0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="EmptySecondaryBtn" TargetType="Button" BasedOn="{StaticResource EmptyPrimaryBtn}">
      <Setter Property="Background" Value="#223248"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                    Padding="{TemplateBinding Padding}" BorderBrush="#2B3D52" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2A3B52"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- ================= WINDOW TITLE BAR + PROJECT TABS ================= -->
    <Border DockPanel.Dock="Top" Height="40" Background="#05080E"
            BorderBrush="#1A2636" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,10,0"
                    MouseLeftButtonDown="TitleBarDrag_MouseLeftButtonDown"
                    WindowChrome.IsHitTestVisibleInChrome="True">
          <TextBlock VerticalAlignment="Center" FontFamily="Segoe UI" FontWeight="Black" FontSize="17"
                     TextOptions.TextFormattingMode="Ideal"
                     TextOptions.TextRenderingMode="Grayscale">
            <Run Text="Y&#x200A;O&#x200A;R&#x200A;T&#x200A;E" Foreground="#FFFFFF"/>
            <Run Text="&#x200A;I&#x200A;M&#x200A;P&#x200A;A&#x200A;C&#x200A;T" Foreground="{StaticResource LogoImpactBrush}"/>
          </TextBlock>
        </StackPanel>

        <ScrollViewer x:Name="TabDropArea" Grid.Column="1" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled" Background="Transparent"
                      AllowDrop="True" DragOver="TabDropArea_DragOver"
                      DragLeave="TabDropArea_DragLeave" Drop="TabDropArea_Drop"
                      MouseLeftButtonDown="TabDropArea_MouseLeftButtonDown"
                      WindowChrome.IsHitTestVisibleInChrome="True">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
            <StackPanel x:Name="TabStrip" Orientation="Horizontal" VerticalAlignment="Bottom"/>
            <Border x:Name="TabDropPlaceholder" Visibility="Collapsed" IsHitTestVisible="False"
                    Height="32" MinWidth="190" Margin="6,0,0,4" Padding="12,0"
                    CornerRadius="6" Background="#111A27"
                    BorderBrush="#2E9BFF" BorderThickness="1" VerticalAlignment="Bottom">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M5,10 H15 M10,5 V15" Stroke="#5FBBFF" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="12" Height="12" Stretch="Uniform"/>
                <TextBlock x:Name="TabDropHintText" Text="Open as new project"
                           Foreground="#E6EEF6" FontSize="11" FontWeight="SemiBold"
                           Margin="7,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Button x:Name="NewTabBtn" Style="{StaticResource NewTabBtn}" Click="NewTab_Click"
                    ToolTip="New canvas tab (Ctrl+T)" Margin="6,0,0,5" VerticalAlignment="Bottom"
                    WindowChrome.IsHitTestVisibleInChrome="True">
              <Path Data="M5,10 H15 M10,5 V15"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Width="14" Height="14" Stretch="Uniform"/>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="2" Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource TitleBarBtn}" Click="WindowMinimize_Click" ToolTip="Minimize">
            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
          </Button>
          <Button Style="{StaticResource TitleBarBtn}" Click="WindowMaximizeRestore_Click" ToolTip="Maximize">
            <TextBlock x:Name="MaxRestoreGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
          </Button>
          <Button Style="{StaticResource TitleBarCloseBtn}" Click="WindowClose_Click" ToolTip="Close">
            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= TOP BAR ================= -->
    <Border DockPanel.Dock="Top" Background="#0D131D" BorderBrush="#1A2636" BorderThickness="0,0,0,1">
      <Grid Height="44">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- file actions -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Button Style="{StaticResource TopBtn}" Click="NewCanvas_Click" ToolTip="New canvas — define size in pixels (Ctrl+N)">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Path Data="M5,2.5 H13.5 L19,8 V21.5 H5 Z M13.5,2.5 V8 H19"
                        Stroke="{StaticResource IconBrush}" StrokeThickness="1.6"
                        StrokeLineJoin="Round" Fill="Transparent"/>
                  <Path Data="M12,11.5 V17.5 M9,14.5 H15"
                        Stroke="#5FBBFF" StrokeThickness="1.8"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="New" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource TopBtn}" Click="OpenProject_Click" ToolTip="Open project (.yimpact) (Ctrl+O)">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Path Data="M3.5,7 H9.2 L11.2,9.2 H20.5 V19.5 H3.5 Z M3.5,7 V4.5 H8.7 L10.7,7"
                        Stroke="{StaticResource IconBrush}" StrokeThickness="1.6"
                        StrokeLineJoin="Round" Fill="Transparent"/>
                  <Path Data="M3.5,11.5 H20.5" Stroke="#5FBBFF" StrokeThickness="1.4"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Open" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource TopBtn}" Click="SaveProject_Click" ToolTip="Save — choose format in the dialog: .yimpact project, PNG, GIF or WebP (Ctrl+S). Save As: Ctrl+Shift+S">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Path Data="M5,3.5 H15.5 L20.5,8.5 V20.5 H5 Z M8,3.5 V9.5 H15.5 V3.5 M8,20.5 V14.5 H17 V20.5"
                        Stroke="{StaticResource IconBrush}" StrokeThickness="1.55"
                        StrokeLineJoin="Round" Fill="Transparent"/>
                  <Path Data="M10.5,6.2 H13" Stroke="#5FBBFF" StrokeThickness="1.3"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Save" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Border Width="1" Height="18" Background="#223248" Margin="5,0"
                  VerticalAlignment="Center"/>
          <Button Style="{StaticResource TopBtn}" Click="CopyAiBrief_Click" ToolTip="Copy a compact AI-readable brief of this sketch">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Path Data="M4,4 H14 V18 H4 Z M7,4 V2 H17 V16"
                        Stroke="{StaticResource IconBrush}" StrokeThickness="1.6"
                        StrokeLineJoin="Round" Fill="Transparent"/>
                  <Path Data="M7,8 H11 M7,11 H11 M7,14 H10"
                        Stroke="{StaticResource IconBrush}" StrokeThickness="1.3"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  <Path Data="M18.7,3.2 L19.5,5.6 L21.9,6.4 L19.5,7.2 L18.7,9.6 L17.9,7.2 L15.5,6.4 L17.9,5.6 Z"
                        Fill="#7FD0FF"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="Copy for AI" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource TopBtn}" Click="Settings_Click" ToolTip="Settings (Ctrl+,) — default canvas size">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                         Foreground="{StaticResource IconBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="Settings" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- document name + canvas size -->
        <StackPanel x:Name="DocInfo" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="{Binding DocumentName}" Foreground="{StaticResource MutedBrush}" FontSize="9.5"
                     VerticalAlignment="Center"/>
          <TextBlock Text="·" Foreground="{StaticResource MutedBrush}" FontSize="9.5"
                     Margin="6,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding CanvasSizeText}" Foreground="{StaticResource MutedBrush}" FontSize="9.5"
                     Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- zoom readout -->
        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
          <Border Background="#111A27" CornerRadius="4" Padding="5,3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource TopBtn}" Padding="7,3" Margin="0" Click="ZoomOut_Click" ToolTip="Zoom out (− / numpad −)">
                <Path Data="M5,12 H19" Stroke="{StaticResource IconBrush}" StrokeThickness="2"
                      Width="13" Height="13" Stretch="Uniform"/>
              </Button>
              <Button x:Name="ZoomLabelBtn" Style="{StaticResource TopBtn}" Padding="7,3" Margin="0"
                      Click="ZoomReset_Click" ToolTip="Reset zoom to 100% (Ctrl+0)" Content="100%" MinWidth="52" FontSize="10.5"/>
              <Button Style="{StaticResource TopBtn}" Padding="7,3" Margin="0" Click="ZoomIn_Click" ToolTip="Zoom in (+ / numpad +)">
                <Path Data="M12,5 V19 M5,12 H19" Stroke="{StaticResource IconBrush}" StrokeThickness="2"
                      Width="13" Height="13" Stretch="Uniform"/>
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>

      </Grid>
    </Border>

    <!-- ================= ATTRIBUTE TOOLBAR (tool settings row) ================= -->
    <Border DockPanel.Dock="Top" Background="#0B1018" BorderBrush="#1A2636" BorderThickness="0,0,0,1">
      <Grid Height="36">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="AttrToolName" Text="PICK" FontWeight="Bold" FontSize="10"
                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="14,0,14,0"/>

        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <Grid>
            <!-- Pick tool settings: object properties (guide pp.97-104) -->
            <StackPanel x:Name="AttrPickPanel" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,12,0" Visibility="Collapsed">
              <ToggleButton x:Name="AttrRatioLockBtn" Style="{StaticResource SegBtn}"
                            Click="AttrRatioLock_Click"
                            ToolTip="Lock aspect ratio while resizing (Shift also keeps proportions)">
                <Grid Width="16" Height="16">
                  <Path x:Name="RatioUnlockIcon"
                        Data="M6,9 H14 V15 H6 Z M8,9 V6 A2,2 0 0 1 12,6"
                        Stroke="{StaticResource IconBrush}" StrokeThickness="1.6"
                        Fill="Transparent" StrokeLineJoin="Round"/>
                  <Path x:Name="RatioLockIcon" Visibility="Collapsed"
                        Data="M6,9 H14 V15 H6 Z M8,9 V6 A2,2 0 0 1 12,6 V9"
                        Stroke="{StaticResource IconBrush}" StrokeThickness="1.6"
                        Fill="Transparent" StrokeLineJoin="Round"/>
                </Grid>
              </ToggleButton>
              <Border Style="{StaticResource AttrSep}" Margin="10,7,16,7"/>

              <controls:ValueSlider Decimals="0" x:Name="AttrOpacity" Caption="Transparency" Suffix="%"
                                    Minimum="0" Maximum="100" Margin="0,0,16,0"
                                    ValueChanged="AttrOpacity_ValueChanged"/>

              <controls:ValueSlider Decimals="0" x:Name="AttrCorner" Caption="Corner" Suffix="px"
                                    Minimum="0" Maximum="250" Margin="0,0,16,0"
                                    ValueChanged="AttrCorner_ValueChanged"/>

              <controls:ValueSlider Decimals="0" x:Name="AttrSoft" Caption="Soft edge" Suffix="%"
                                    Minimum="0" Maximum="100" Margin="0,0,8,0"
                                    ValueChanged="AttrSoft_ValueChanged"/>

              <Border Style="{StaticResource AttrSep}" Margin="10,7,16,7"/>
              <Button Style="{StaticResource AttrBtn}" Click="BringFront_Click" ToolTip="Bring to front (top level)">
                <Path Data="M4,3 H20 M12,20 V7 M7,11 L12,6 L17,11" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="1.9" Fill="Transparent" Width="15" Height="15" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource AttrBtn}" Click="BringFwd_Click" ToolTip="Bring forward (up one level)">
                <Path Data="M6,14 L12,8 L18,14" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="2" Fill="Transparent" Width="15" Height="15" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource AttrBtn}" Click="SendBwd_Click" ToolTip="Send backward (down one level)">
                <Path Data="M6,10 L12,16 L18,10" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="2" Fill="Transparent" Width="15" Height="15" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource AttrBtn}" Click="SendBack_Click" ToolTip="Send to back (bottom level)">
                <Path Data="M4,21 H20 M12,4 V17 M7,13 L12,18 L17,13" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="1.9" Fill="Transparent" Width="15" Height="15" Stretch="Uniform"/>
              </Button>

              <Border Style="{StaticResource AttrSep}" Margin="10,7,16,7"/>
              <Button Style="{StaticResource AttrBtn}" Tag="L" Click="AlignToCanvas_Click" ToolTip="Align left edge to the canvas">
                <Path Data="M3,3 V15 M6,6 H15 M6,12 H12" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="1.6" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource AttrBtn}" Tag="H" Click="AlignToCanvas_Click" ToolTip="Align horizontal center to the canvas">
                <Path Data="M9,3 V15 M4,6 H14 M6,12 H12" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="1.6" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource AttrBtn}" Tag="R" Click="AlignToCanvas_Click" ToolTip="Align right edge to the canvas">
                <Path Data="M15,3 V15 M3,6 H12 M6,12 H12" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="1.6" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource AttrBtn}" Tag="T" Click="AlignToCanvas_Click" ToolTip="Align top edge to the canvas">
                <Path Data="M3,3 H15 M6,6 V15 M12,6 V12" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="1.6" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource AttrBtn}" Tag="V" Click="AlignToCanvas_Click" ToolTip="Align vertical center to the canvas">
                <Path Data="M3,9 H15 M6,4 V14 M12,6 V12" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="1.6" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource AttrBtn}" Tag="B" Click="AlignToCanvas_Click" ToolTip="Align bottom edge to the canvas">
                <Path Data="M3,15 H15 M6,3 V12 M12,6 V12" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="1.6" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource AttrBtn}" Tag="C" Click="AlignToCanvas_Click" ToolTip="Center on the canvas (horizontal + vertical)">
                <Path Data="M3,3 H15 V15 H3 Z M9,6 V12 M6,9 H12" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="1.6" Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
              </Button>

              <Border Style="{StaticResource AttrSep}" Margin="10,7,16,7"/>
              <Button Style="{StaticResource AttrBtn}" Click="FlipH_Click" ToolTip="Flip horizontal">
                <Path Data="M9,5 L4,12 L9,19 M15,5 L20,12 L15,19 M12,4 V20"
                      Stroke="{StaticResource IconBrush}" StrokeThickness="1.7" Fill="Transparent"
                      Width="15" Height="15" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource AttrBtn}" Click="FlipV_Click" ToolTip="Flip vertical">
                <Path Data="M5,9 L12,4 L19,9 M5,15 L12,20 L19,15 M4,12 H20"
                      Stroke="{StaticResource IconBrush}" StrokeThickness="1.7" Fill="Transparent"
                      Width="15" Height="15" Stretch="Uniform"/>
              </Button>
            </StackPanel>

            <!-- Slice tool settings -->
            <StackPanel x:Name="AttrSlicePanel" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,12,0" Visibility="Collapsed">
              <ToggleButton x:Name="TopAddSliceBtn" Style="{StaticResource TopToggle}"
                            Click="SliceAdd_Click" ToolTip="Add slices instead of replacing">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M12,5 V19 M5,12 H19" Stroke="{StaticResource IconBrush}" StrokeThickness="2"
                        Width="14" Height="14" Stretch="Uniform"/>
                  <TextBlock Text="Add slice" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </ToggleButton>
              <TextBlock Text="Each drag replaces the slice by default — turn this on to keep several."
                         Style="{StaticResource AttrCaption}" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- Background remover settings -->
            <StackPanel x:Name="AttrErasePanel" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,12,0" Visibility="Collapsed">
              <controls:ValueSlider Decimals="0" x:Name="AttrEraseTolerance" Caption="Tolerance" Suffix="%"
                                    Minimum="0" Maximum="100" Margin="0,0,16,0"/>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <ToggleButton x:Name="AttrEraseContiguous" Style="{StaticResource TopToggle}"
                              IsChecked="True" ToolTip="Erase only the connected color region (off = every matching pixel in the image)">
                  <TextBlock Text="Contiguous" VerticalAlignment="Center"/>
                </ToggleButton>
                <Button Style="{StaticResource AttrBtn}" Click="AttrEraseAuto_Click" Margin="7,0,0,0"
                        ToolTip="Erase the background connected to the image border">
                  <TextBlock Text="Auto"/>
                </Button>
              </StackPanel>
              <TextBlock Text="Click an image to erase the color under the cursor; Auto removes the border background."
                         Style="{StaticResource AttrCaption}" Margin="4,0,0,0"/>
            </StackPanel>

            <!-- Paintbrush settings -->
            <StackPanel x:Name="AttrBrushPanel" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,12,0" Visibility="Collapsed">
              <Border Style="{StaticResource SegGroup}" Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                  <ToggleButton x:Name="AttrBrushPaintBtn" Style="{StaticResource SegBtn}"
                                Tag="Paint" Click="AttrBrushStyle_Click" ToolTip="Paint">
                    <Path Data="M11,1 L15,5 L8,12 L4,8 Z M4,8 L1,15 L8,12"
                          Stroke="{StaticResource IconBrush}" StrokeThickness="1.5"
                          Fill="Transparent" StrokeLineJoin="Round"
                          Width="15" Height="15" Stretch="Uniform"/>
                  </ToggleButton>
                  <ToggleButton x:Name="AttrBrushSmudgeBtn" Style="{StaticResource SegBtn}"
                                Tag="Smudge" Click="AttrBrushStyle_Click"
                                ToolTip="Smudge / Blur - evens out colors under the brush">
                    <Path Data="M2,11 C4,7 6,13 8,9 C10,5 12,11 14,8 M2,5 C4,3 6,6 8,4 C10,2 12,5 14,4"
                          Stroke="{StaticResource IconBrush}" StrokeThickness="1.6"
                          Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="15" Height="15" Stretch="Uniform"/>
                  </ToggleButton>
                  <ToggleButton x:Name="AttrBrushWaterBtn" Style="{StaticResource SegBtn}"
                                Tag="Watercolor" Click="AttrBrushStyle_Click" ToolTip="Watercolor">
                    <Path Data="M8,1 C8,1 13,7 13,10 A5,5 0 1 1 3,10 C3,7 8,1 8,1 Z"
                          Stroke="{StaticResource IconBrush}" StrokeThickness="1.5"
                          Fill="Transparent" StrokeLineJoin="Round"
                          Width="15" Height="15" Stretch="Uniform"/>
                  </ToggleButton>
                  <ToggleButton x:Name="AttrBrushEraserBtn" Style="{StaticResource SegBtn}"
                                Tag="Eraser" Click="AttrBrushStyle_Click" ToolTip="Eraser">
                    <Path Data="M2,11 L8,2 L14,7 L8,16 Z M1,18 H15"
                          Stroke="{StaticResource IconBrush}" StrokeThickness="1.5"
                          Fill="Transparent" StrokeLineJoin="Round"
                          Width="15" Height="15" Stretch="Uniform"/>
                  </ToggleButton>
                  <ToggleButton x:Name="AttrBrushMergeBtn" Style="{StaticResource SegBtn}"
                                Tag="Merge" Click="AttrBrushStyle_Click"
                                ToolTip="Merge - paints the colors from behind the image">
                    <Path Data="M2,2 H9 V9 H2 Z M7,7 H14 V14 H7 Z"
                          Stroke="{StaticResource IconBrush}" StrokeThickness="1.5"
                          Fill="Transparent" StrokeLineJoin="Round"
                          Width="15" Height="15" Stretch="Uniform"/>
                  </ToggleButton>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource SegGroup}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <ToggleButton x:Name="AttrBrushAutoBtn" Style="{StaticResource SegBtn}"
                                Tag="Auto" Click="AttrBrushTarget_Click"
                                ToolTip="Auto - paints the selected object or image, or a clicked image; otherwise the canvas">
                    <Path Data="M8,1 L9.4,5.2 L13.6,6.6 L9.4,8 L8,12.2 L6.6,8 L2.4,6.6 L6.6,5.2 Z"
                          Fill="{StaticResource IconBrush}" Width="15" Height="15" Stretch="Uniform"/>
                  </ToggleButton>
                  <ToggleButton x:Name="AttrBrushCanvasBtn" Style="{StaticResource SegBtn}"
                                Tag="Canvas" Click="AttrBrushTarget_Click"
                                ToolTip="Canvas - always paints the canvas layer">
                    <Rectangle Width="13" Height="10" RadiusX="1" RadiusY="1"
                               Stroke="{StaticResource IconBrush}" StrokeThickness="1.6"
                               Fill="Transparent"/>
                  </ToggleButton>
                  <ToggleButton x:Name="AttrBrushSelectedBtn" Style="{StaticResource SegBtn}"
                                Tag="Selected" Click="AttrBrushTarget_Click"
                                ToolTip="Selected - paints the selected object or image only">
                    <Grid Width="15" Height="15">
                      <Path Data="M3,5 H12 V11 H3 Z"
                            Stroke="{StaticResource IconBrush}" StrokeThickness="1.2"
                            StrokeDashArray="2 1.5" Fill="Transparent"/>
                      <Rectangle Width="3" Height="3" Fill="{StaticResource IconBrush}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1"/>
                      <Rectangle Width="3" Height="3" Fill="{StaticResource IconBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="1"/>
                    </Grid>
                  </ToggleButton>
                </StackPanel>
              </Border>

              <Button x:Name="AttrBrushColorBtn" Style="{StaticResource AttrSwatch}"
                      Click="AttrBrushColor_Click" Margin="0,0,8,0"
                      ToolTip="Brush color (Alt+click on the canvas samples a color)"/>

              <Border Width="54" Height="24" Margin="0,0,10,0" CornerRadius="3"
                      Background="{StaticResource PreviewChecker}"
                      BorderBrush="#223248" BorderThickness="1" ClipToBounds="True"
                      ToolTip="Live brush preview">
                <Image x:Name="AttrBrushPreview" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
              </Border>

              <controls:ValueSlider x:Name="AttrBrushSize" Decimals="0" Caption="Size" Suffix="px"
                                    Minimum="1" Maximum="300" Margin="0,0,14,0"
                                    ValueChanged="AttrBrushSize_ValueChanged"/>

              <controls:ValueSlider x:Name="AttrBrushOpacity" Decimals="0" Caption="Opacity" Suffix="%"
                                    Minimum="0" Maximum="100" Margin="0,0,14,0"
                                    ValueChanged="AttrBrushOpacity_ValueChanged"/>

              <controls:ValueSlider x:Name="AttrBrushSoft" Decimals="0" Caption="Soft edge" Suffix="%"
                                    Minimum="0" Maximum="100" Margin="0,0,14,0"
                                    ValueChanged="AttrBrushSoft_ValueChanged"/>

              <controls:ValueSlider x:Name="AttrBrushSmooth" Decimals="0" Caption="Smooth" Suffix="%"
                                    Minimum="0" Maximum="100" Margin="0,0,8,0"
                                    ValueChanged="AttrBrushSmooth_ValueChanged"/>

              <Border Style="{StaticResource AttrSep}"/>
              <ToggleButton x:Name="AttrBrushPresetBtn" Style="{StaticResource SegBtn}"
                            ToolTip="Brush presets">
                <Path Data="M4,2 H12 V14 L8,11 L4,14 Z"
                      Stroke="{StaticResource IconBrush}" StrokeThickness="1.5"
                      Fill="Transparent" StrokeLineJoin="Round"
                      Width="14" Height="15" Stretch="Uniform"/>
              </ToggleButton>
              <Popup x:Name="AttrBrushPresetPopup" Placement="Bottom"
                     PlacementTarget="{Binding ElementName=AttrBrushPresetBtn}"
                     IsOpen="{Binding IsChecked, ElementName=AttrBrushPresetBtn, Mode=TwoWay}"
                     StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="#111A27" BorderBrush="#223248" BorderThickness="1"
                        CornerRadius="4" Padding="8" Margin="0,4,8,8" Width="230">
                  <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="10" ShadowDepth="2"/>
                  </Border.Effect>
                  <StackPanel>
                    <TextBlock Text="BRUSH PRESETS" Style="{StaticResource AttrLabel}"
                               Margin="4,0,0,5"/>
                    <ItemsControl x:Name="AttrBrushPresetList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Width="210">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="56" Height="24"
                                    Margin="0,1,7,1" CornerRadius="3"
                                    Background="{StaticResource PreviewChecker}"
                                    BorderBrush="#223248" BorderThickness="1"
                                    ClipToBounds="True">
                              <Image Source="{Binding Preview}" Stretch="Fill"
                                     RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource PresetItemBtn}"
                                    Click="AttrBrushPresetItem_Click" Tag="{Binding}">
                              <TextBlock Text="{Binding Name}" FontSize="11"
                                         TextTrimming="CharacterEllipsis"/>
                            </Button>
                            <Button Grid.Column="2" Padding="5,4" Margin="2,1"
                                    HorizontalContentAlignment="Center"
                                    Click="AttrBrushPresetDeleteItem_Click" Tag="{Binding}"
                                    ToolTip="Delete this preset">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PresetItemBtn}">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanDelete}" Value="False">
                                      <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Button.Style>
                              <TextBlock Text="&#x00D7;" FontSize="12"/>
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </Popup>
              <TextBlock x:Name="AttrBrushPresetName" Text="Custom"
                         Style="{StaticResource AttrCaption}" MaxWidth="76"
                         TextTrimming="CharacterEllipsis" Margin="2,0,4,0"
                         VerticalAlignment="Center"/>
              <Button Style="{StaticResource AttrBtn}" Click="AttrBrushPresetSave_Click"
                      ToolTip="Save the current brush settings as a preset">
                <TextBlock Text="+" FontSize="13" FontWeight="Bold"/>
              </Button>

              <TextBlock Text="B: paint, [ / ] size, Alt+click samples"
                         Style="{StaticResource AttrCaption}" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Text tool settings -->
            <StackPanel x:Name="AttrTextPanel" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,12,0" Visibility="Collapsed">
              <Button x:Name="AttrTextColorBtn" Style="{StaticResource AttrSwatch}"
                      Click="AttrTextColor_Click" ToolTip="Text color" Margin="0,0,8,0"/>

              <ComboBox x:Name="AttrTextFontCombo" Style="{StaticResource DarkCombo}" Width="150"
                        Height="28" Margin="0,0,6,0" MaxDropDownHeight="300"
                        ItemContainerStyle="{StaticResource DarkComboItem}"
                        SelectionChanged="AttrTextFont_SelectionChanged"
                        ToolTip="Font family">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <controls:ValueSlider x:Name="AttrTextSize" Compact="True" Decimals="0"
                                    Minimum="6" Maximum="300" Margin="0,0,8,0"
                                    ValueChanged="AttrTextSize_ValueChanged"
                                    ToolTip="Font size"/>

              <Border Style="{StaticResource SegGroup}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                  <ToggleButton x:Name="AttrTextBoldBtn" Style="{StaticResource SegBtn}"
                                Click="AttrTextStyle_Click" ToolTip="Bold">
                    <TextBlock Text="B" FontWeight="Bold" FontSize="12"/>
                  </ToggleButton>
                  <ToggleButton x:Name="AttrTextItalicBtn" Style="{StaticResource SegBtn}"
                                Click="AttrTextStyle_Click" ToolTip="Italic">
                    <TextBlock Text="I" FontStyle="Italic" FontSize="12"/>
                  </ToggleButton>
                  <ToggleButton x:Name="AttrTextUnderlineBtn" Style="{StaticResource SegBtn}"
                                Click="AttrTextStyle_Click" ToolTip="Underline">
                    <TextBlock Text="U" TextDecorations="Underline" FontSize="12"/>
                  </ToggleButton>
                  <ToggleButton x:Name="AttrTextStrikeBtn" Style="{StaticResource SegBtn}"
                                Click="AttrTextStyle_Click" ToolTip="Strikethrough">
                    <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="12"/>
                  </ToggleButton>
                </StackPanel>
              </Border>

              <ToggleButton x:Name="AttrTextSpacingBtn" Style="{StaticResource SegBtn}"
                            ToolTip="Letter spacing" Margin="0,0,2,0">
                <Grid Width="18" Height="18">
                  <Rectangle Stroke="{StaticResource IconBrush}" StrokeThickness="1"
                             StrokeDashArray="2 2" Fill="Transparent" Margin="0.5"/>
                  <TextBlock Text="A" FontSize="11" HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Grid>
              </ToggleButton>
              <Popup x:Name="AttrTextSpacingPopup" Placement="Bottom"
                     PlacementTarget="{Binding ElementName=AttrTextSpacingBtn}"
                     IsOpen="{Binding IsChecked, ElementName=AttrTextSpacingBtn, Mode=TwoWay}"
                     StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="#111A27" BorderBrush="#223248" BorderThickness="1"
                        CornerRadius="4" Padding="10,8" Margin="0,4,8,8">
                  <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="10" ShadowDepth="2"/>
                  </Border.Effect>
                  <StackPanel>
                    <TextBlock Text="LETTER SPACING" Style="{StaticResource AttrLabel}"
                               Margin="0,0,0,6"/>
                    <controls:ValueSlider x:Name="AttrTextSpacing" Decimals="0" Suffix="px"
                                          Minimum="0" Maximum="50"
                                          ValueChanged="AttrTextSpacing_ValueChanged"/>
                  </StackPanel>
                </Border>
              </Popup>

              <Border Style="{StaticResource SegGroup}" Margin="0,0,8,0">
                <Button x:Name="AttrTextAlignBtn" Style="{StaticResource AttrBtn}"
                        Click="AttrTextAlign_Click" ToolTip="Alignment: right (click to change)">
                  <Path x:Name="AttrTextAlignIcon"
                        Data="M3,5 H21 M10,10 H21 M3,15 H21 M13,20 H21"
                        Stroke="{StaticResource IconBrush}" StrokeThickness="1.7"
                        Fill="Transparent" Width="16" Height="16" Stretch="Uniform"/>
                </Button>
              </Border>

              <Border Style="{StaticResource AttrSep}"/>

              <CheckBox x:Name="AttrTextBorderCheck" Style="{StaticResource DarkSwitch}"
                        Content="Border" Margin="0,0,6,0"
                        Checked="AttrTextBorder_Toggled" Unchecked="AttrTextBorder_Toggled"
                        ToolTip="Outline around the text"/>
              <Button x:Name="AttrTextBorderColorBtn" Style="{StaticResource AttrSwatch}"
                      Click="AttrTextBorderColor_Click" ToolTip="Border color" Margin="0,0,6,0"
                      Background="#000000"/>
              <controls:ValueSlider x:Name="AttrTextBorderThickness" Compact="True" Decimals="0"
                                    Minimum="0" Maximum="20" Margin="0,0,8,0"
                                    ValueChanged="AttrTextBorderThickness_ValueChanged"
                                    ToolTip="Border thickness"/>

              <Border Style="{StaticResource AttrSep}"/>

              <CheckBox x:Name="AttrTextShadowCheck" Style="{StaticResource DarkSwitch}"
                        Content="Shadow" Margin="0,0,6,0"
                        Checked="AttrTextShadow_Toggled" Unchecked="AttrTextShadow_Toggled"
                        ToolTip="Drop shadow"/>
              <Button x:Name="AttrTextShadowColorBtn" Style="{StaticResource AttrSwatch}"
                      Click="AttrTextShadowColor_Click" ToolTip="Shadow color"
                      Background="#000000"/>
            </StackPanel>

            <!-- Rectangle (shape) tool settings -->
            <StackPanel x:Name="AttrRectPanel" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,12,0" Visibility="Collapsed">
              <Border Style="{StaticResource SegGroup}" Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                  <ToggleButton x:Name="AttrShapeRectBtn" Style="{StaticResource SegBtn}"
                                Tag="Rectangle" Click="AttrShapeKind_Click" ToolTip="Rectangle">
                    <Rectangle Width="14" Height="11" RadiusX="1.5" RadiusY="1.5"
                               Stroke="{StaticResource IconBrush}" StrokeThickness="1.8"
                               Fill="Transparent"/>
                  </ToggleButton>
                  <ToggleButton x:Name="AttrShapeEllipseBtn" Style="{StaticResource SegBtn}"
                                Tag="Ellipse" Click="AttrShapeKind_Click" ToolTip="Ellipse">
                    <Ellipse Width="14" Height="11" Stroke="{StaticResource IconBrush}"
                             StrokeThickness="1.8" Fill="Transparent"/>
                  </ToggleButton>
                  <ToggleButton x:Name="AttrShapeTriangleBtn" Style="{StaticResource SegBtn}"
                                Tag="Triangle" Click="AttrShapeKind_Click" ToolTip="Triangle">
                    <Path Data="M8,0 L16,13 H0 Z" Width="14" Height="13" Stretch="Uniform"
                          Stroke="{StaticResource IconBrush}" StrokeThickness="1.8"
                          StrokeLineJoin="Round" Fill="Transparent"/>
                  </ToggleButton>
                  <ToggleButton x:Name="AttrShapePolygonBtn" Style="{StaticResource SegBtn}"
                                Tag="Polygon" Click="AttrShapeKind_Click"
                                ToolTip="Polygon — click points to draw">
                    <Path Data="M8,0 L16,4.9 L13.2,13 H2.8 L0,4.9 Z" Width="14" Height="13"
                          Stretch="Uniform" Stroke="{StaticResource IconBrush}"
                          StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"/>
                  </ToggleButton>
                </StackPanel>
              </Border>
              <ToggleButton x:Name="AttrDrawRatioLockBtn" Style="{StaticResource SegBtn}"
                            Margin="1,0,6,0" Click="AttrDrawRatioLock_Click"
                            ToolTip="Keep width and height equal while drawing (square/circle)">
                <Grid Width="16" Height="16">
                  <Path x:Name="DrawRatioUnlockIcon"
                        Data="M6,9 H14 V15 H6 Z M8,9 V6 A2,2 0 0 1 12,6"
                        Stroke="{StaticResource IconBrush}" StrokeThickness="1.6"
                        Fill="Transparent" StrokeLineJoin="Round"/>
                  <Path x:Name="DrawRatioLockIcon" Visibility="Collapsed"
                        Data="M6,9 H14 V15 H6 Z M8,9 V6 A2,2 0 0 1 12,6 V9"
                        Stroke="{StaticResource IconBrush}" StrokeThickness="1.6"
                        Fill="Transparent" StrokeLineJoin="Round"/>
                </Grid>
              </ToggleButton>
              <Button x:Name="AttrShapeFill1Btn" Style="{StaticResource AttrSwatch}"
                      Click="AttrShapeFill1_Click" ToolTip="Fill color" Margin="0,0,6,0"/>
              <ComboBox x:Name="AttrShapeFillModeCombo" Style="{StaticResource DarkCombo}" Width="92"
                        Height="28" Margin="0,0,6,0" ItemContainerStyle="{StaticResource DarkComboItem}"
                        SelectionChanged="AttrShapeFillMode_SelectionChanged" ToolTip="Fill type">
                <ComboBoxItem Content="Solid"/>
                <ComboBoxItem Content="Gradient"/>
              </ComboBox>
              <Button x:Name="AttrShapeFill2Btn" Style="{StaticResource AttrSwatch}"
                      Click="AttrShapeFill2_Click" ToolTip="Gradient end color" Margin="0,0,8,0"
                      Visibility="Collapsed"/>

              <controls:ValueSlider x:Name="AttrShapeCorner" Compact="True" Decimals="0"
                                    Minimum="0" Maximum="250" Margin="0,0,8,0"
                                    Caption="Corner" ValueChanged="AttrShapeCorner_ValueChanged"
                                    ToolTip="Corner radius"/>

              <Border Style="{StaticResource AttrSep}"/>

              <CheckBox x:Name="AttrShapeBorderCheck" Style="{StaticResource DarkSwitch}"
                        Content="Border" Margin="0,0,6,0"
                        Checked="AttrShapeBorder_Toggled" Unchecked="AttrShapeBorder_Toggled"
                        ToolTip="Shape border"/>
              <Button x:Name="AttrShapeBorderColorBtn" Style="{StaticResource AttrSwatch}"
                      Click="AttrShapeBorderColor_Click" ToolTip="Border color" Margin="0,0,6,0"
                      Background="#26549F"/>
              <controls:ValueSlider x:Name="AttrShapeBorderThickness" Compact="True" Decimals="0"
                                    Minimum="0" Maximum="20" Margin="0,0,8,0"
                                    ValueChanged="AttrShapeBorderThickness_ValueChanged"
                                    ToolTip="Border thickness"/>

              <Border Style="{StaticResource AttrSep}"/>

              <CheckBox x:Name="AttrShapeShadowCheck" Style="{StaticResource DarkSwitch}"
                        Content="Shadow" Margin="0,0,6,0"
                        Checked="AttrShapeShadow_Toggled" Unchecked="AttrShapeShadow_Toggled"
                        ToolTip="Drop shadow"/>
              <Button x:Name="AttrShapeShadowColorBtn" Style="{StaticResource AttrSwatch}"
                      Click="AttrShapeShadowColor_Click" ToolTip="Shadow color"
                      Background="#000000"/>
            </StackPanel>

            <!-- other tools: hint -->
            <TextBlock x:Name="AttrHint" VerticalAlignment="Center" Margin="4,0,10,0"
                       Foreground="#AEBCCC" FontSize="10" TextWrapping="NoWrap"/>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- ================= STATUS BAR ================= -->
    <StatusBar DockPanel.Dock="Bottom" MinHeight="26" Background="#0D131D" Foreground="#8EA0B4">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="Pick tool: click to select, drag to move. Ctrl+V pastes an image."/>
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="ZoomStatusText" Text="100%" Margin="0,0,14,0"/>
          <TextBlock x:Name="SelectionText" Text="Nothing selected" Margin="0,0,10,0"/>
          <ToggleButton x:Name="GridToggleBtn" Style="{StaticResource SegBtn}"
                        Width="22" Height="22" Margin="0" Background="Transparent"
                        VerticalAlignment="Center" Click="GridToggle_Click"
                        ToolTip="Show guides and measurements. Right-click: grid settings and columns.">
            <ToggleButton.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Grid settings…" Click="OpenGridSettings_Click"/>
                <Separator/>
                <MenuItem Header="4 columns" Tag="4" Click="GridColumns_Click"/>
                <MenuItem Header="6 columns" Tag="6" Click="GridColumns_Click"/>
                <MenuItem Header="8 columns" Tag="8" Click="GridColumns_Click"/>
                <MenuItem Header="12 columns" Tag="12" Click="GridColumns_Click"/>
                <MenuItem Header="16 columns" Tag="16" Click="GridColumns_Click"/>
              </ContextMenu>
            </ToggleButton.ContextMenu>
            <Path Data="M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z"
                  Stroke="{StaticResource IconBrush}" StrokeThickness="1.6" Fill="Transparent"
                  Width="14" Height="14" Stretch="Uniform"/>
          </ToggleButton>
        </StackPanel>
      </StatusBarItem>
    </StatusBar>

    <!-- ================= LEFT SIDEBAR (narrow tool strip) ================= -->
    <Border DockPanel.Dock="Left" Width="44" Background="#0D131D"
            BorderBrush="#1A2636" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,6,0,0">
          <!-- fa-arrow-pointer -->
          <ToggleButton x:Name="SidePickBtn" Style="{StaticResource SideTool}" IsChecked="True"
                        Click="ToolPick_Click" ToolTip="Pick tool (V)">
            <Path Data="M7,3 L20,12.5 L13,13.5 L10,21 Z" Fill="{StaticResource IconBrush}"
                  Width="20" Height="20" Stretch="Uniform"/>
          </ToggleButton>
          <!-- fa-crop-simple -->
          <ToggleButton x:Name="SideSliceBtn" Style="{StaticResource SideTool}"
                        Click="ToolSlice_Click" ToolTip="Slice tool (M) — drag a dashed region">
            <Path Data="M4,9 V4 H9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15"
                  Stroke="{StaticResource IconBrush}" StrokeThickness="2" Fill="Transparent"
                  Width="20" Height="20" Stretch="Uniform"/>
          </ToggleButton>
          <!-- paintbrush -->
          <ToggleButton x:Name="SideBrushBtn" Style="{StaticResource SideTool}"
                        Click="ToolBrush_Click" ToolTip="Paintbrush (B) - paint, smudge, watercolor, erase or merge into the background">
            <Grid Width="20" Height="20">
              <Path Data="M15,3 L20,8 L11,17 L6,12 Z"
                    Stroke="{StaticResource IconBrush}" StrokeThickness="1.6"
                    Fill="Transparent" StrokeLineJoin="Round"/>
              <Path Data="M6,12 L2,21 L11,17"
                    Stroke="{StaticResource IconBrush}" StrokeThickness="1.6"
                    Fill="Transparent" StrokeLineJoin="Round"/>
            </Grid>
          </ToggleButton>

          <!-- background remover (magic wand) -->
          <ToggleButton x:Name="SideEraseBtn" Style="{StaticResource SideTool}"
                        Click="ToolErase_Click" ToolTip="Background remover (E) - click an image to erase a color, or Auto to erase the border background">
            <Grid Width="20" Height="20">
              <Grid>
                <Grid.RenderTransform>
                  <TranslateTransform Y="-3"/>
                </Grid.RenderTransform>
                <Rectangle Width="11" Height="16" RadiusX="2.2" RadiusY="2.2"
                           Stroke="{StaticResource IconBrush}" StrokeThickness="1.7" Fill="Transparent"
                           RenderTransformOrigin="0.5,0.5">
                  <Rectangle.RenderTransform>
                    <RotateTransform Angle="45"/>
                  </Rectangle.RenderTransform>
                </Rectangle>
                <Path Data="M8.5,4.5 L15.5,11.5" Stroke="{StaticResource IconBrush}"
                      StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Grid>
              <Path Data="M1,19 H6 M10,19 H19" Stroke="{StaticResource IconBrush}"
                    StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Grid>
          </ToggleButton>

          <Border Style="{StaticResource RailDivider}"/>
          <!-- fa-square : rectangle draw tool -->
          <ToggleButton x:Name="SideRectBtn" Style="{StaticResource SideTool}"
                        Click="ToolRect_Click" ToolTip="Path drawing tool (R) — drag for rectangle/ellipse/triangle, or click points for Polygon">
            <Grid Width="22" Height="22">
              <Rectangle Width="11" Height="11" RadiusX="2" RadiusY="2"
                         Stroke="{StaticResource IconBrush}" StrokeThickness="2.3"
                         StrokeLineJoin="Round"
                         Fill="{StaticResource IconBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="0,0,0,0"/>
              <Ellipse Width="10" Height="10" Stroke="{StaticResource IconBrush}"
                       StrokeThickness="2.3" Fill="#26E6EEF6"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,0"/>
            </Grid>
          </ToggleButton>
          <!-- text tool -->
          <ToggleButton x:Name="SideTextBtn" Style="{StaticResource SideTool}"
                        Click="ToolText_Click" ToolTip="Text (T) - click the canvas and type; RTL supported">
            <Path Data="M4,5 H20 M12,5 V20" Stroke="{StaticResource IconBrush}"
                  StrokeThickness="2" Fill="Transparent" Width="20" Height="20" Stretch="Uniform"/>
          </ToggleButton>

          <Border Style="{StaticResource RailDivider}"/>
          <Button Style="{StaticResource SideBtn}" Click="PrimaryColorPick_Click"
                  ToolTip="Color picker - pick the main color from the screen">
            <Viewbox Width="20" Height="20">
              <Canvas Width="24" Height="24">
                <Path Data="M4,20 L5,15.2 L15.2,5 L19,8.8 L8.8,19 Z"
                      Fill="{StaticResource IconBrush}"/>
                <Path Data="M15.2,5 L17.6,2.6 A2.6,2.6 0 0 1 21.4,6.4 L19,8.8 Z"
                      Fill="{StaticResource IconBrush}"/>
                <Path Data="M4,20 L5,15.2 L8.8,19 Z" Fill="#2E9BFF"/>
              </Canvas>
            </Viewbox>
          </Button>
          <Button Style="{StaticResource SideBtn}" Click="PrimaryColor_Click"
                  ToolTip="Main color - click to open the color picker">
            <Border x:Name="PrimaryColorSwatch" Width="20" Height="20" CornerRadius="4"
                    BorderBrush="#6B7C92" BorderThickness="1"/>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ================= RIGHT INSPECTOR ================= -->
    <Border x:Name="InspectorBorder" DockPanel.Dock="Right" Width="260" Background="#0D131D" BorderBrush="#1A2636" BorderThickness="0">
      <Grid>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <StackPanel>
          <Border Background="#0B121B" BorderBrush="#1A2636" BorderThickness="1"
                  CornerRadius="5" Padding="2" Margin="12,12,12,9">
            <UniformGrid x:Name="RightTabs" Columns="2">
              <ToggleButton x:Name="InspectorTabBtn" Style="{StaticResource RightTabBtn}"
                            Content="Inspector" IsChecked="True" Click="InspectorTab_Click"/>
              <ToggleButton x:Name="PhotoTabBtn" Style="{StaticResource RightTabBtn}"
                            Content="Photo" IsEnabled="False" Click="PhotoTab_Click"/>
              <ToggleButton x:Name="GridTabBtn" Style="{StaticResource RightTabBtn}"
                            Content="Grid" Visibility="Collapsed" Click="GridTab_Click"/>
            </UniformGrid>
          </Border>
          <Border x:Name="MultiSelectionCard" Visibility="Collapsed"
                  Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1"
                  Padding="11" Margin="0">
            <StackPanel>
              <Border Style="{StaticResource SectionBand}">
                <Grid>
                  <Border Width="2" HorizontalAlignment="Left" Background="#2E9BFF"/>
                  <TextBlock x:Name="MultiSelectionText" Style="{StaticResource SectionHeader}"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>
              </Border>
              <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="#AEBCCC" LineHeight="17"
                         Text="Drag a selected object to move the group. Shift = snap, arrow keys nudge, Delete removes all."/>
            </StackPanel>
          </Border>
          <StackPanel x:Name="InspectorPanel">
          <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="11" x:Name="GeometryCard">
            <StackPanel>
              <Border Style="{StaticResource SectionBand}">
                <Grid>
                  <Border Width="2" HorizontalAlignment="Left" Background="#2E9BFF"/>
                  <TextBlock Text="GEOMETRY" Style="{StaticResource SectionHeader}"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>
              </Border>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="X" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                <controls:ValueSlider Grid.Column="1" Compact="True" Decimals="0" x:Name="InspX" Suffix="px"
                                      Minimum="-4000" Maximum="8000" ValueChanged="InspX_ValueChanged"/>
                <TextBlock Grid.Column="3" Text="Y" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                <controls:ValueSlider Grid.Column="4" Compact="True" Decimals="0" x:Name="InspY" Suffix="px"
                                      Minimum="-4000" Maximum="8000" ValueChanged="InspY_ValueChanged"/>
              </Grid>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="26"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="W" ToolTip="Width" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                <controls:ValueSlider Grid.Column="1" Compact="True" Decimals="0" x:Name="InspW" Suffix="px"
                                      Minimum="1" Maximum="8000" ValueChanged="InspW_ValueChanged"/>
                <TextBlock Grid.Column="3" Text="H" ToolTip="Height" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                <controls:ValueSlider Grid.Column="4" Compact="True" Decimals="0" x:Name="InspH" Suffix="px"
                                      Minimum="1" Maximum="8000" ValueChanged="InspH_ValueChanged"/>
                <ToggleButton x:Name="InspRatioLockBtn" Grid.Column="5" Style="{StaticResource SegBtn}"
                              Width="24" Height="24" Margin="3,0,0,0" Click="InspRatioLock_Click"
                              ToolTip="Lock aspect ratio (synced with the Pick tool)">
                  <Grid Width="14" Height="14">
                    <Path x:Name="InspRatioUnlockIcon"
                          Data="M6,9 H14 V15 H6 Z M8,9 V6 A2,2 0 0 1 12,6"
                          Stroke="{StaticResource IconBrush}" StrokeThickness="1.6"
                          Fill="Transparent" StrokeLineJoin="Round"/>
                    <Path x:Name="InspRatioLockIcon" Visibility="Collapsed"
                          Data="M6,9 H14 V15 H6 Z M8,9 V6 A2,2 0 0 1 12,6 V9"
                          Stroke="{StaticResource IconBrush}" StrokeThickness="1.6"
                          Fill="Transparent" StrokeLineJoin="Round"/>
                  </Grid>
                </ToggleButton>
              </Grid>
              <Grid x:Name="InspCornerRow" Margin="0,2,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="Corner" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="InspRadius" Suffix="px"
                                      Minimum="0" Maximum="250" ValueChanged="InspRadius_ValueChanged"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="11"
                  x:Name="ImageCard" Visibility="Collapsed">
            <StackPanel>
              <Border Style="{StaticResource SectionBand}">
                <Grid>
                  <Border Width="2" HorizontalAlignment="Left" Background="#2E9BFF"/>
                  <TextBlock Text="IMAGE" Style="{StaticResource SectionHeader}"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>
              </Border>
              <TextBlock Text="Resize mode" Style="{StaticResource FieldLabel}"/>
              <Border Style="{StaticResource SegGroup}" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="ImageFitFillRadio" GroupName="ImageFit" Style="{StaticResource SegRadio}"
                               Content="Crop" Tag="Fill" Checked="ImageFit_Checked"
                               ToolTip="Fill the box and crop the image (keeps proportions)"/>
                  <RadioButton x:Name="ImageFitFitRadio" GroupName="ImageFit" Style="{StaticResource SegRadio}"
                               Content="Fit" Tag="Fit" Checked="ImageFit_Checked"
                               ToolTip="Show the whole image with empty space around it"/>
                  <RadioButton x:Name="ImageFitStretchRadio" GroupName="ImageFit" Style="{StaticResource SegRadio}"
                               Content="Stretch" Tag="Stretch" Checked="ImageFit_Checked"
                               ToolTip="Stretch the image to the box (changes proportions)"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="11" x:Name="RotationCard">
            <StackPanel>
              <Border Style="{StaticResource SectionBand}">
                <Grid>
                  <Border Width="2" HorizontalAlignment="Left" Background="#2E9BFF"/>
                  <TextBlock Text="ROTATION" Style="{StaticResource SectionHeader}"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>
              </Border>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <controls:ValueSlider Decimals="0" x:Name="InspRot" Suffix="°"
                                      Minimum="-180" Maximum="180" ValueChanged="InspRot_ValueChanged"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                  <Button Style="{StaticResource AttrBtn}" Width="26" Height="26" Padding="0" Margin="0"
                          Click="RotateLeft90_Click" ToolTip="Rotate 90° left (counter-clockwise)">
                    <TextBlock Text="↺" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="{StaticResource IconBrush}"/>
                  </Button>
                  <Button Style="{StaticResource AttrBtn}" Width="26" Height="26" Padding="0" Margin="4,0,0,0"
                          Click="RotateRight90_Click" ToolTip="Rotate 90° right (clockwise)">
                    <TextBlock Text="↻" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="{StaticResource IconBrush}"/>
                  </Button>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Shape fill + border (visible only for ShapeElement) -->
          <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="11" x:Name="AppearanceCard">
            <StackPanel>
              <Border Style="{StaticResource SectionBand}">
                <Grid>
                  <Border Width="2" HorizontalAlignment="Left" Background="#2E9BFF"/>
                  <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>
              </Border>
              <TextBlock Text="Fill" Style="{StaticResource FieldLabel}"/>
              <Border Style="{StaticResource SegGroup}" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="FillSolidRadio" Style="{StaticResource SegRadio}" Content="Solid" Checked="FillMode_Checked"/>
                  <RadioButton x:Name="FillGradientRadio" Style="{StaticResource SegRadio}" Content="Gradient" Checked="FillMode_Checked"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="Fill1Label" Text="Color 1" Style="{StaticResource FieldLabel}"/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="Fill1Box" Style="{StaticResource TopBtn}" Padding="0" Height="26" Tag="Fill1" Click="ColorPreview_Click" ToolTip="Pick fill color 1"/>
                <TextBox x:Name="Fill1Text" Grid.Column="2" Style="{StaticResource DarkBox}" Margin="0" Tag="Fill1" TextChanged="FillText_TextChanged" ToolTip="Hex, e.g. #3B82F6"/>
              </Grid>
              <StackPanel x:Name="GradientOptions">
                <TextBlock Text="Color 2" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Button x:Name="Fill2Box" Style="{StaticResource TopBtn}" Padding="0" Height="26" Tag="Fill2" Click="ColorPreview_Click" ToolTip="Pick fill color 2"/>
                  <TextBox x:Name="Fill2Text" Grid.Column="2" Style="{StaticResource DarkBox}" Margin="0" Tag="Fill2" TextChanged="FillText_TextChanged" ToolTip="Hex, e.g. #93C5FD"/>
                </Grid>
                <TextBlock Text="Gradient type" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="GradTypeCombo" Style="{StaticResource DarkCombo}" SelectionChanged="GradTypeCombo_SelectionChanged">
                  <ComboBoxItem Content="Linear"/>
                  <ComboBoxItem Content="Radial"/>
                  <ComboBoxItem Content="Elliptical"/>
                </ComboBox>
                <Grid x:Name="GradAngleRow" Margin="0,4,0,6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="Direction" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                  <Border Grid.Column="1" Style="{StaticResource SegGroup}" Padding="2" HorizontalAlignment="Left">
                    <UniformGrid x:Name="ShapeGradDirections" Rows="3" Columns="3">
                      <ToggleButton Style="{StaticResource SegBtn}" Width="22" Height="22" Margin="1"
                                    FontFamily="Segoe UI Symbol" FontSize="13"
                                    Tag="315" Content="↖" Click="ShapeGradientDirection_Click"/>
                      <ToggleButton Style="{StaticResource SegBtn}" Width="22" Height="22" Margin="1"
                                    FontFamily="Segoe UI Symbol" FontSize="13"
                                    Tag="0" Content="↑" Click="ShapeGradientDirection_Click"/>
                      <ToggleButton Style="{StaticResource SegBtn}" Width="22" Height="22" Margin="1"
                                    FontFamily="Segoe UI Symbol" FontSize="13"
                                    Tag="45" Content="↗" Click="ShapeGradientDirection_Click"/>
                      <ToggleButton Style="{StaticResource SegBtn}" Width="22" Height="22" Margin="1"
                                    FontFamily="Segoe UI Symbol" FontSize="13"
                                    Tag="270" Content="←" Click="ShapeGradientDirection_Click"/>
                      <Border Background="Transparent"/>
                      <ToggleButton Style="{StaticResource SegBtn}" Width="22" Height="22" Margin="1"
                                    FontFamily="Segoe UI Symbol" FontSize="13"
                                    Tag="90" Content="→" Click="ShapeGradientDirection_Click"/>
                      <ToggleButton Style="{StaticResource SegBtn}" Width="22" Height="22" Margin="1"
                                    FontFamily="Segoe UI Symbol" FontSize="13"
                                    Tag="225" Content="↙" Click="ShapeGradientDirection_Click"/>
                      <ToggleButton Style="{StaticResource SegBtn}" Width="22" Height="22" Margin="1"
                                    FontFamily="Segoe UI Symbol" FontSize="13"
                                    Tag="180" Content="↓" Click="ShapeGradientDirection_Click"/>
                      <ToggleButton Style="{StaticResource SegBtn}" Width="22" Height="22" Margin="1"
                                    FontFamily="Segoe UI Symbol" FontSize="13"
                                    Tag="135" Content="↘" Click="ShapeGradientDirection_Click"/>
                    </UniformGrid>
                  </Border>
                  <controls:ValueSlider Grid.Column="1" Visibility="Collapsed" Decimals="0" x:Name="InspGradAngle" Suffix="°"
                                        Minimum="0" Maximum="360" ValueChanged="InspGradAngle_ValueChanged"/>
                </Grid>
              </StackPanel>
              <TextBlock Text="Border" Style="{StaticResource FieldLabel}"/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="StrokeBox" Style="{StaticResource TopBtn}" Padding="0" Height="26" Tag="Stroke" Click="ColorPreview_Click" ToolTip="Pick border color"/>
                <TextBox x:Name="StrokeText" Grid.Column="2" Style="{StaticResource DarkBox}" Margin="0" Tag="Stroke" TextChanged="FillText_TextChanged" ToolTip="Hex, e.g. #1E3A8A"/>
              </Grid>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="Thickness" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                <controls:ValueSlider Decimals="0" Grid.Column="1" x:Name="InspStrokeThick" Suffix="px"
                                      Minimum="0" Maximum="100" ValueChanged="InspStrokeThick_ValueChanged"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Font + style + alignment (visible only for TextElement) -->
          <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="11" x:Name="TextCard">
            <StackPanel>
              <Border Style="{StaticResource SectionBand}">
                <Grid>
                  <Border Width="2" HorizontalAlignment="Left" Background="#2E9BFF"/>
                  <TextBlock Text="TEXT" Style="{StaticResource SectionHeader}"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>
              </Border>

              <TextBlock Text="Font" Style="{StaticResource FieldLabel}"/>
              <Grid Margin="0,0,0,6">
                <TextBox x:Name="TextFontSearch" Style="{StaticResource DarkBox}" Margin="0" Padding="24,5,6,5"
                         TextChanged="TextFontSearch_TextChanged" ToolTip="Search fonts by name"/>
                <Path Data="M5,5 A3.5,3.5 0 1,1 4.99,5 M7,7 L11,11" Stroke="#8EA0B4" StrokeThickness="1.5"
                      Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="6,0,0,0" IsHitTestVisible="False"/>
                <TextBlock Text="Search font…" Foreground="#6F8094" FontSize="11" Margin="26,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=TextFontSearch}" Value="">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
              <ComboBox x:Name="TextFontCombo" Style="{StaticResource DarkCombo}" IsTextSearchEnabled="True"
                        ItemContainerStyle="{StaticResource FontComboItem}"
                        DropDownOpened="TextFont_DropDownOpened"
                        DropDownClosed="TextFont_DropDownClosed"
                        PreviewKeyDown="TextFont_PreviewKeyDown"
                        SelectionChanged="TextFont_SelectionChanged"
                        ToolTip="Hover or ↑/↓ to preview; Enter applies">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="Size" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="TextSize" Suffix="px"
                                      Minimum="6" Maximum="300" ValueChanged="TextSize_ValueChanged"/>
              </Grid>

              <Border Style="{StaticResource SegGroup}" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                  <ToggleButton x:Name="TextBoldBtn" Style="{StaticResource SegBtn}" Click="TextStyle_Click" ToolTip="Bold">
                    <TextBlock Text="B" FontWeight="Bold" FontSize="13"/>
                  </ToggleButton>
                  <ToggleButton x:Name="TextItalicBtn" Style="{StaticResource SegBtn}" Click="TextStyle_Click" ToolTip="Italic">
                    <TextBlock Text="I" FontStyle="Italic" FontSize="13"/>
                  </ToggleButton>
                  <ToggleButton x:Name="TextUnderlineBtn" Style="{StaticResource SegBtn}" Click="TextStyle_Click" ToolTip="Underline">
                    <TextBlock Text="U" TextDecorations="Underline" FontSize="13"/>
                  </ToggleButton>
                  <ToggleButton x:Name="TextStrikeBtn" Style="{StaticResource SegBtn}" Click="TextStyle_Click" ToolTip="Strikethrough">
                    <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="13"/>
                  </ToggleButton>
                </StackPanel>
              </Border>

              <TextBlock Text="Align" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
              <Border Style="{StaticResource SegGroup}" Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <ToggleButton x:Name="TextAlignLeftBtn" Style="{StaticResource SegBtn}" Click="TextAlign_Click" ToolTip="Align left">
                    <Path Data="M3,5 H21 M3,10 H14 M3,15 H21 M3,20 H11" Stroke="{StaticResource IconBrush}"
                          StrokeThickness="1.7" Fill="Transparent" Width="16" Height="16" Stretch="Uniform"/>
                  </ToggleButton>
                  <ToggleButton x:Name="TextAlignCenterBtn" Style="{StaticResource SegBtn}" Click="TextAlign_Click" ToolTip="Center">
                    <Path Data="M3,5 H21 M6,10 H18 M3,15 H21 M7,20 H17" Stroke="{StaticResource IconBrush}"
                          StrokeThickness="1.7" Fill="Transparent" Width="16" Height="16" Stretch="Uniform"/>
                  </ToggleButton>
                  <ToggleButton x:Name="TextAlignRightBtn" Style="{StaticResource SegBtn}" Click="TextAlign_Click" ToolTip="Align right">
                    <Path Data="M3,5 H21 M10,10 H21 M3,15 H21 M13,20 H21" Stroke="{StaticResource IconBrush}"
                          StrokeThickness="1.7" Fill="Transparent" Width="16" Height="16" Stretch="Uniform"/>
                  </ToggleButton>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Text fill / gradient -->
          <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="11" x:Name="TextFillCard">
            <StackPanel>
              <Border Style="{StaticResource SectionBand}">
                <Grid>
                  <Border Width="2" HorizontalAlignment="Left" Background="#2E9BFF"/>
                  <TextBlock Text="FILL" Style="{StaticResource SectionHeader}"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource SegGroup}" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="TextFillSolidRadio" Style="{StaticResource SegRadio}" Content="Solid" Checked="TextFillMode_Checked"/>
                  <RadioButton x:Name="TextFillGradientRadio" Style="{StaticResource SegRadio}" Content="Gradient" Checked="TextFillMode_Checked"/>
                </StackPanel>
              </Border>

              <TextBlock Text="Color" Style="{StaticResource FieldLabel}"/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="TextColor1Box" Style="{StaticResource TopBtn}" Padding="0" Height="26" Tag="TextFill1" Click="ColorPreview_Click" ToolTip="Pick text color"/>
                <TextBox x:Name="TextColor1Text" Grid.Column="2" Style="{StaticResource DarkBox}" Margin="0" Tag="TextFill1" TextChanged="FillText_TextChanged" ToolTip="Hex, e.g. #1E293B"/>
              </Grid>

              <StackPanel x:Name="TextGradientOptions">
                <TextBlock Text="Color 2" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Button x:Name="TextColor2Box" Style="{StaticResource TopBtn}" Padding="0" Height="26" Tag="TextFill2" Click="ColorPreview_Click" ToolTip="Pick gradient end color"/>
                  <TextBox x:Name="TextColor2Text" Grid.Column="2" Style="{StaticResource DarkBox}" Margin="0" Tag="TextFill2" TextChanged="FillText_TextChanged" ToolTip="Hex, e.g. #2E9BFF"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="Direction" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                  <Border Grid.Column="1" Style="{StaticResource SegGroup}" Padding="2" HorizontalAlignment="Left">
                    <UniformGrid x:Name="TextGradDirections" Rows="3" Columns="3">
                      <ToggleButton Style="{StaticResource SegBtn}" Width="22" Height="22" Margin="1"
                                    FontFamily="Segoe UI Symbol" FontSize="13"
                                    Tag="315" Content="↖" Click="TextGradientDirection_Click"/>
                      <ToggleButton Style="{StaticResource SegBtn}" Width="22" Height="22" Margin="1"
                                    FontFamily="Segoe UI Symbol" FontSize="13"
                                    Tag="0" Content="↑" Click="TextGradientDirection_Click"/>
                      <ToggleButton Style="{StaticResource SegBtn}" Width="22" Height="22" Margin="1"
                                    FontFamily="Segoe UI Symbol" FontSize="13"
                                    Tag="45" Content="↗" Click="TextGradientDirection_Click"/>
                      <ToggleButton Style="{StaticResource SegBtn}" Width="22" Height="22" Margin="1"
                                    FontFamily="Segoe UI Symbol" FontSize="13"
                                    Tag="270" Content="←" Click="TextGradientDirection_Click"/>
                      <Border Background="Transparent"/>
                      <ToggleButton Style="{StaticResource SegBtn}" Width="22" Height="22" Margin="1"
                                    FontFamily="Segoe UI Symbol" FontSize="13"
                                    Tag="90" Content="→" Click="TextGradientDirection_Click"/>
                      <ToggleButton Style="{StaticResource SegBtn}" Width="22" Height="22" Margin="1"
                                    FontFamily="Segoe UI Symbol" FontSize="13"
                                    Tag="225" Content="↙" Click="TextGradientDirection_Click"/>
                      <ToggleButton Style="{StaticResource SegBtn}" Width="22" Height="22" Margin="1"
                                    FontFamily="Segoe UI Symbol" FontSize="13"
                                    Tag="180" Content="↓" Click="TextGradientDirection_Click"/>
                      <ToggleButton Style="{StaticResource SegBtn}" Width="22" Height="22" Margin="1"
                                    FontFamily="Segoe UI Symbol" FontSize="13"
                                    Tag="135" Content="↘" Click="TextGradientDirection_Click"/>
                    </UniformGrid>
                  </Border>
                  <controls:ValueSlider Grid.Column="1" Visibility="Collapsed" Decimals="0" x:Name="TextGradAngle" Suffix="°"
                                        Minimum="0" Maximum="360" ValueChanged="TextGradAngle_ValueChanged"/>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Directional fade-to-transparent (collapsible) -->
          <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="11,11,11,0" x:Name="TransparencyCard">
            <StackPanel>
              <ToggleButton x:Name="TransparencyToggle" Style="{StaticResource ExtraHeader}" Content="TRANSPARENCY" Click="Transparency_Click"/>
              <StackPanel x:Name="TransparencyContent" Visibility="Collapsed" Margin="0,10,0,11">
                <CheckBox x:Name="OpacityGradientCheck" Style="{StaticResource DarkSwitch}" Content="Gradient transparency"
                          Checked="OpacityGradient_Toggled" Unchecked="OpacityGradient_Toggled"/>
                <StackPanel x:Name="OpacityOptions" Visibility="Collapsed" Margin="0,8,0,0">
                  <TextBlock Text="Direction" Style="{StaticResource FieldLabel}"/>
                  <ItemsControl x:Name="TransparencyPresetList" Margin="0,2,0,4">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource ShadowPresetTile}" Tag="{Binding}"
                                Click="TransparencyPresetItem_Click" ToolTip="{Binding ToolTip}">
                          <StackPanel>
                            <Border Width="30" Height="22" Background="{Binding PreviewBrush}"
                                    CornerRadius="3" BorderBrush="#223248" BorderThickness="1"
                                    HorizontalAlignment="Center" Margin="0,2"/>
                            <TextBlock Text="{Binding Name}" FontSize="9" Foreground="#C7D6E6"
                                       TextAlignment="Center"/>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <controls:ValueSlider Inline="True" Caption="Strength" x:Name="OpacityStrength" Suffix="%"
                                        Decimals="0" Minimum="0" Maximum="100"
                                        Margin="0,0,0,7" ValueChanged="OpacityStrength_ValueChanged"/>
                  <controls:ValueSlider Inline="True" Caption="Start" x:Name="OpacityStart" Suffix="%"
                                        Decimals="0" Minimum="0" Maximum="100"
                                        Margin="0,0,0,7" ValueChanged="OpacityStart_ValueChanged"/>
                  <controls:ValueSlider Inline="True" Caption="End" x:Name="OpacityEnd" Suffix="%"
                                        Decimals="0" Minimum="0" Maximum="100"
                                        ValueChanged="OpacityEnd_ValueChanged"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Spacing / wrap / shadow, hidden until expanded -->
          <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="11,11,11,0" x:Name="TextExtraCard">
            <StackPanel>
              <ToggleButton x:Name="TextExtraToggle" Style="{StaticResource ExtraHeader}" Content="EXTRA SETTINGS" Click="TextExtra_Click"/>
              <StackPanel x:Name="TextExtraContent" Visibility="Collapsed" Margin="0,10,0,11">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="Letter spacing" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                  <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="TextLetterSpacing" Suffix="px"
                                        Minimum="0" Maximum="50" ValueChanged="TextLetterSpacing_ValueChanged"/>
                </Grid>
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="Line spacing" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                  <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="TextLineSpacing" Suffix="%"
                                        Minimum="50" Maximum="300" ValueChanged="TextLineSpacing_ValueChanged"/>
                </Grid>

                <CheckBox x:Name="TextWrapCheck" Style="{StaticResource DarkSwitch}" Content="Limit width" Margin="0,10,0,0"
                          Checked="TextWrap_Toggled" Unchecked="TextWrap_Toggled"/>
                <Grid x:Name="TextWrapRow" Margin="0,6,0,0" Visibility="Collapsed">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="Wrap width" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                  <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="TextWrapWidth" Suffix="px"
                                        Minimum="40" Maximum="2000" ValueChanged="TextWrapWidth_ValueChanged"/>
                </Grid>

                <CheckBox x:Name="TextShadowCheck" Style="{StaticResource DarkSwitch}" Content="Drop shadow" Margin="0,10,0,0"
                          Checked="TextShadow_Toggled" Unchecked="TextShadow_Toggled"/>
                <StackPanel x:Name="TextShadowOptions" Margin="0,6,0,0">
                  <TextBlock Text="Shadow color" Style="{StaticResource FieldLabel}"/>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button x:Name="TextShadowColorBox" Style="{StaticResource TopBtn}" Padding="0" Height="26" Tag="TextShadow" Click="ColorPreview_Click" ToolTip="Pick shadow color"/>
                    <TextBox x:Name="TextShadowText" Grid.Column="2" Style="{StaticResource DarkBox}" Margin="0" Tag="TextShadow" TextChanged="FillText_TextChanged" ToolTip="Hex, e.g. #000000"/>
                  </Grid>
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="X" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                    <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="TextShadowX" Suffix="px"
                                          Minimum="-40" Maximum="40" ValueChanged="TextShadowX_ValueChanged"/>
                  </Grid>
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="Y" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                    <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="TextShadowY" Suffix="px"
                                          Minimum="-40" Maximum="40" ValueChanged="TextShadowY_ValueChanged"/>
                  </Grid>
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="Blur" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                    <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="TextShadowBlur" Suffix="px"
                                          Minimum="0" Maximum="200" ValueChanged="TextShadowBlur_ValueChanged"/>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="Opacity" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                    <controls:ValueSlider Grid.Column="1" Decimals="0" x:Name="TextShadowOpacity" Suffix="%"
                                          Minimum="0" Maximum="100" ValueChanged="TextShadowOpacity_ValueChanged"/>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Shadow (any element) -->
          <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="11" x:Name="ShadowCard">
            <StackPanel>
              <Border Style="{StaticResource SectionBand}">
                <Grid>
                  <Border Width="2" HorizontalAlignment="Left" Background="#2E9BFF"/>
                  <TextBlock Text="SHADOW" Style="{StaticResource SectionHeader}"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>
              </Border>
              <ItemsControl x:Name="ShadowPresetList" Margin="0,2,0,4">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="3"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource ShadowPresetTile}" Tag="{Binding}"
                            Click="ShadowPresetItem_Click" ToolTip="{Binding Name}">
                      <StackPanel>
                        <Grid Height="46">
                          <Border Width="56" Height="40" Background="#223248" CornerRadius="4"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8">
                            <Border Background="#F2F5F9" CornerRadius="4"
                                    Effect="{Binding PreviewEffect}"/>
                          </Border>
                        </Grid>
                        <TextBlock Text="{Binding Name}" FontSize="9" Foreground="#C7D6E6"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel x:Name="ShadowOptions" Margin="0,4,0,0">
                <TextBlock Text="Color" Style="{StaticResource FieldLabel}"/>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Button x:Name="ShadowColorBox" Style="{StaticResource TopBtn}" Padding="0" Height="26" Tag="Shadow" Click="ColorPreview_Click" ToolTip="Pick shadow color"/>
                  <TextBox x:Name="ShadowText" Grid.Column="2" Style="{StaticResource DarkBox}" Margin="0" Tag="Shadow" TextChanged="FillText_TextChanged" ToolTip="Hex, e.g. #000000"/>
                </Grid>

                <controls:ValueSlider Inline="True" Caption="X" x:Name="ShadowX" Suffix="px"
                                      Decimals="0" Minimum="-40" Maximum="40"
                                      Margin="0,0,0,7" ValueChanged="ShadowX_ValueChanged"/>
                <controls:ValueSlider Inline="True" Caption="Y" x:Name="ShadowY" Suffix="px"
                                      Decimals="0" Minimum="-40" Maximum="40"
                                      Margin="0,0,0,7" ValueChanged="ShadowY_ValueChanged"/>
                <controls:ValueSlider Inline="True" Caption="Blur" x:Name="ShadowBlur" Suffix="px"
                                      Decimals="0" Minimum="0" Maximum="200"
                                      Margin="0,0,0,7" ValueChanged="ShadowBlur_ValueChanged"/>
                <controls:ValueSlider Inline="True" Caption="Opacity" x:Name="ShadowOpacity" Suffix="%"
                                      Decimals="0" Minimum="0" Maximum="100"
                                      ValueChanged="ShadowOpacity_ValueChanged"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="11">
            <StackPanel>
              <Border Style="{StaticResource SectionBand}">
                <Grid>
                  <Border Width="2" HorizontalAlignment="Left" Background="#2E9BFF"/>
                  <TextBlock Text="WORKFLOW" Style="{StaticResource SectionHeader}"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </Grid>
              </Border>
              <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="#AEBCCC" LineHeight="17"
                         Text="Pick (V): select/move/resize; rotate with the Rotation slider or the ↺ ↻ buttons. Slice (M): drag regions, click activates; Delete cuts; Space toggles markers; arrows nudge. Ctrl+F fill/text/canvas color, Ctrl+Z/Y undo/redo."/>
              <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="#AEBCCC" LineHeight="17" Margin="0,8,0,0"
                         Text="Paste images with Ctrl+V or drag files in. − / + (both keyboards) or Ctrl+wheel zooms. Space clears the selection — click the element to select it again."/>
            </StackPanel>
          </Border>
        </StackPanel>

          <StackPanel x:Name="PhotoPanel" Visibility="Collapsed">
            <Border Style="{StaticResource TopBand}">
              <Grid>
                <Border Width="2" HorizontalAlignment="Left" Background="#2E9BFF"/>
                <TextBlock Text="PHOTO" Style="{StaticResource SectionHeader}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
              </Grid>
            </Border>
            <TextBlock x:Name="PhotoEmptyText" Text="Select an image on the canvas to edit it."
                       TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                       Margin="2,4,2,0" Visibility="Collapsed"/>
            <StackPanel x:Name="PhotoContent">
              <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="8">
                <StackPanel>
                  <Border Height="64" Background="#04070D" CornerRadius="3" ClipToBounds="True">
                    <Viewbox Stretch="Fill">
                      <Canvas Width="220" Height="64">
                        <Polyline x:Name="PhotoHistR" Stroke="#FF6B6B" StrokeThickness="1" Opacity="0.9"/>
                        <Polyline x:Name="PhotoHistG" Stroke="#65D38A" StrokeThickness="1" Opacity="0.9"/>
                        <Polyline x:Name="PhotoHistB" Stroke="#5CA8FF" StrokeThickness="1" Opacity="0.9"/>
                      </Canvas>
                    </Viewbox>
                  </Border>
                  <TextBlock x:Name="PhotoMetaText" FontSize="10" Foreground="{StaticResource MutedBrush}"
                             Margin="1,6,1,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Border>

              <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="11">
                <StackPanel>
                  <Border Style="{StaticResource SectionBand}">
                    <Grid>
                      <Border Width="2" HorizontalAlignment="Left" Background="#2E9BFF"/>
                      <TextBlock Text="EDIT" Style="{StaticResource SectionHeader}"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </Grid>
                  </Border>
                  <UniformGrid Columns="4">
                    <Button Content="Auto" Style="{StaticResource AttrBtn}" Background="#0B121B"
                            BorderBrush="#223248" BorderThickness="1" Click="PhotoQuickAuto_Click"/>
                    <Button Content="B&amp;W" Style="{StaticResource AttrBtn}" Background="#0B121B"
                            BorderBrush="#223248" BorderThickness="1" Click="PhotoQuickBw_Click"/>
                    <Button Content="HDR" Style="{StaticResource AttrBtn}" Background="#0B121B"
                            BorderBrush="#223248" BorderThickness="1" Click="PhotoQuickHdr_Click"/>
                    <Button Content="Reset" Style="{StaticResource AttrBtn}" Background="#0B121B"
                            BorderBrush="#223248" BorderThickness="1" Click="PhotoReset_Click"/>
                  </UniformGrid>
                </StackPanel>
              </Border>

              <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="11,11,11,0">
                <StackPanel>
                  <ToggleButton x:Name="PhotoPresetsToggle" Style="{StaticResource ExtraHeader}"
                                Content="PRESETS" IsChecked="True" Click="PhotoSection_Click" Tag="Presets"/>
                  <StackPanel x:Name="PhotoPresetsContent" Margin="0,8,0,11">
                    <ItemsControl x:Name="PhotoPresetList">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Style="{StaticResource PhotoPresetTile}" Tag="{Binding}" Click="PhotoPreset_Click"
                                  ToolTip="{Binding Name}">
                            <StackPanel>
                              <Border Height="62" Background="#04070D" CornerRadius="3" ClipToBounds="True">
                                <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
                              </Border>
                              <TextBlock Text="{Binding Name}" FontSize="9.5" Foreground="#C7D6E6"
                                         TextAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="11,11,11,0">
                <StackPanel>
                  <ToggleButton x:Name="PhotoLightToggle" Style="{StaticResource ExtraHeader}"
                                Content="LIGHT" IsChecked="True" Click="PhotoSection_Click" Tag="Light"/>
                  <StackPanel x:Name="PhotoLightContent" Margin="0,9,0,11">
                    <controls:ValueSlider Inline="True" Caption="Exposure" x:Name="PhotoExposure" Tag="Exposure"
                                          Decimals="2" Step="0.05" Suffix="EV" Minimum="-5" Maximum="5"
                                          Margin="0,0,0,7" ValueChanged="PhotoAdjust_ValueChanged"/>
                    <controls:ValueSlider Inline="True" Caption="Contrast" x:Name="PhotoContrast" Tag="Contrast"
                                          Decimals="0" Suffix="%" Minimum="-100" Maximum="100"
                                          Margin="0,0,0,7" ValueChanged="PhotoAdjust_ValueChanged"/>
                    <controls:ValueSlider Inline="True" Caption="Highlights" x:Name="PhotoHighlights" Tag="Highlights"
                                          Decimals="0" Suffix="%" Minimum="-100" Maximum="100"
                                          Margin="0,0,0,7" ValueChanged="PhotoAdjust_ValueChanged"/>
                    <controls:ValueSlider Inline="True" Caption="Shadows" x:Name="PhotoShadows" Tag="Shadows"
                                          Decimals="0" Suffix="%" Minimum="-100" Maximum="100"
                                          Margin="0,0,0,7" ValueChanged="PhotoAdjust_ValueChanged"/>
                    <controls:ValueSlider Inline="True" Caption="Whites" x:Name="PhotoWhites" Tag="Whites"
                                          Decimals="0" Suffix="%" Minimum="-100" Maximum="100"
                                          Margin="0,0,0,7" ValueChanged="PhotoAdjust_ValueChanged"/>
                    <controls:ValueSlider Inline="True" Caption="Blacks" x:Name="PhotoBlacks" Tag="Blacks"
                                          Decimals="0" Suffix="%" Minimum="-100" Maximum="100"
                                          ValueChanged="PhotoAdjust_ValueChanged"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="11,11,11,0">
                <StackPanel>
                  <ToggleButton x:Name="PhotoColorToggle" Style="{StaticResource ExtraHeader}"
                                Content="COLOR" Click="PhotoSection_Click" Tag="Color"/>
                  <StackPanel x:Name="PhotoColorContent" Margin="0,9,0,11" Visibility="Collapsed">
                    <controls:ValueSlider Inline="True" Caption="Temperature" x:Name="PhotoTemperature" Tag="Temperature"
                                          Decimals="0" Suffix="%" Minimum="-100" Maximum="100"
                                          TrackBrush="{StaticResource PhotoTemperatureTrack}"
                                          Margin="0,0,0,7" ValueChanged="PhotoAdjust_ValueChanged"/>
                    <controls:ValueSlider Inline="True" Caption="Tint" x:Name="PhotoTint" Tag="Tint"
                                          Decimals="0" Suffix="%" Minimum="-100" Maximum="100"
                                          TrackBrush="{StaticResource PhotoTintTrack}"
                                          Margin="0,0,0,7" ValueChanged="PhotoAdjust_ValueChanged"/>
                    <controls:ValueSlider Inline="True" Caption="Vibrance" x:Name="PhotoVibrance" Tag="Vibrance"
                                          Decimals="0" Suffix="%" Minimum="-100" Maximum="100"
                                          Margin="0,0,0,7" ValueChanged="PhotoAdjust_ValueChanged"/>
                    <controls:ValueSlider Inline="True" Caption="Saturation" x:Name="PhotoSaturation" Tag="Saturation"
                                          Decimals="0" Suffix="%" Minimum="-100" Maximum="100"
                                          ValueChanged="PhotoAdjust_ValueChanged"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="11,11,11,0">
                <StackPanel>
                  <ToggleButton x:Name="PhotoToneToggle" Style="{StaticResource ExtraHeader}"
                                Content="TONE" Click="PhotoSection_Click" Tag="Tone"/>
                  <StackPanel x:Name="PhotoToneContent" Margin="0,9,0,11" Visibility="Collapsed">
                    <Grid Margin="0,0,0,6">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition/>
                      </Grid.ColumnDefinitions>
                      <Button x:Name="PhotoToneColorBox" Style="{StaticResource AttrSwatch}"
                              Width="30" Height="26" Click="PhotoToneColor_Click"
                              ToolTip="Pick the tone color"/>
                      <controls:ValueSlider Grid.Column="2" Inline="True" Caption="Amount"
                                            x:Name="PhotoToneAmount" Tag="ToneAmount"
                                            Decimals="0" Suffix="%" Minimum="0" Maximum="100"
                                            ValueChanged="PhotoAdjust_ValueChanged"/>
                    </Grid>
                    <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource MutedBrush}"
                               Text="Maps the image to shades of the chosen color — orange, purple, teal or any other tone."/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="11,11,11,0">
                <StackPanel>
                  <ToggleButton x:Name="PhotoEffectsToggle" Style="{StaticResource ExtraHeader}"
                                Content="EFFECTS" Click="PhotoSection_Click" Tag="Effects"/>
                  <StackPanel x:Name="PhotoEffectsContent" Margin="0,9,0,11" Visibility="Collapsed">
                    <controls:ValueSlider Inline="True" Caption="Blur" x:Name="PhotoBlur" Tag="Blur"
                                          Decimals="0" Suffix="%" Minimum="0" Maximum="100"
                                          Margin="0,0,0,7" ValueChanged="PhotoAdjust_ValueChanged"/>
                    <controls:ValueSlider Inline="True" Caption="Sharpen" x:Name="PhotoSharpen" Tag="Sharpen"
                                          Decimals="0" Suffix="%" Minimum="0" Maximum="100"
                                          Margin="0,0,0,7" ValueChanged="PhotoAdjust_ValueChanged"/>
                    <controls:ValueSlider Inline="True" Caption="Glow" x:Name="PhotoGlow" Tag="Glow"
                                          Decimals="0" Suffix="%" Minimum="0" Maximum="100"
                                          Margin="0,0,0,7" ValueChanged="PhotoAdjust_ValueChanged"/>
                    <controls:ValueSlider Inline="True" Caption="Clarity" x:Name="PhotoClarity" Tag="Clarity"
                                          Decimals="0" Suffix="%" Minimum="-100" Maximum="100"
                                          Margin="0,0,0,7" ValueChanged="PhotoAdjust_ValueChanged"/>
                    <controls:ValueSlider Inline="True" Caption="Vignette" x:Name="PhotoVignette" Tag="Vignette"
                                          Decimals="0" Suffix="%" Minimum="-100" Maximum="100"
                                          Margin="0,0,0,7" ValueChanged="PhotoAdjust_ValueChanged"/>
                    <controls:ValueSlider Inline="True" Caption="Grain" x:Name="PhotoGrain" Tag="Grain"
                                          Decimals="0" Suffix="%" Minimum="0" Maximum="100"
                                          ValueChanged="PhotoAdjust_ValueChanged"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="11">
                <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="#AEBCCC" LineHeight="17"
                           Text="Photo edits are non-destructive: the original pixels stay intact, presets can be changed or reset at any time, and exports use the adjusted result."/>
              </Border>
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="GridPanel" Visibility="Collapsed">
            <Border Style="{StaticResource TopBand}">
              <Grid>
                <Border Width="2" HorizontalAlignment="Left" Background="#2E9BFF"/>
                <TextBlock Text="CANVAS" Style="{StaticResource SectionHeader}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
              </Grid>
            </Border>
            <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="11">
              <StackPanel>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Background" Foreground="{StaticResource MutedBrush}" FontSize="10"
                             VerticalAlignment="Center"/>
                  <Button x:Name="CanvasBgSwatchBtn" Grid.Column="2" Style="{StaticResource AttrSwatch}"
                          HorizontalAlignment="Left" Click="CanvasBgSwatch_Click"
                          ToolTip="Canvas background color"/>
                </Grid>
                <CheckBox x:Name="CanvasTransparentCheck" Style="{StaticResource DarkSwitch}"
                          Content="Transparent background"
                          Checked="CanvasTransparent_Toggled" Unchecked="CanvasTransparent_Toggled"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource TopBand}">
              <Grid>
                <Border Width="2" HorizontalAlignment="Left" Background="#2E9BFF"/>
                <TextBlock Text="GRID" Style="{StaticResource SectionHeader}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"/>
              </Grid>
            </Border>
            <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="11">
              <StackPanel>
                <CheckBox x:Name="GridShowCheck" Style="{StaticResource DarkSwitch}"
                          Content="Show grid" Checked="GridShow_Toggled" Unchecked="GridShow_Toggled"/>
                <CheckBox x:Name="GridCenterCheck" Style="{StaticResource DarkSwitch}"
                          Content="Center line" Margin="0,10,0,12"
                          Checked="GridCenter_Toggled" Unchecked="GridCenter_Toggled"/>
                <controls:ValueSlider Inline="True" Caption="Columns" x:Name="GridColumns"
                                      Decimals="0" Step="1" Minimum="2" Maximum="24"
                                      Margin="0,0,0,7" ValueChanged="GridColumns_ValueChanged"/>
                <controls:ValueSlider Inline="True" Caption="Margin" x:Name="GridMargin"
                                      Decimals="0" Suffix="px" Minimum="0" Maximum="400"
                                      Margin="0,0,0,7" ValueChanged="GridMargin_ValueChanged"/>
                <controls:ValueSlider Inline="True" Caption="Gutter" x:Name="GridGutter"
                                      Decimals="0" Suffix="px" Minimum="0" Maximum="200"
                                      Margin="0,0,0,7" ValueChanged="GridGutter_ValueChanged"/>
                <controls:ValueSlider Inline="True" Caption="Opacity" x:Name="GridOpacity"
                                      Decimals="0" Suffix="%" Minimum="0" Maximum="100"
                                      ValueChanged="GridOpacity_ValueChanged"/>
              </StackPanel>
            </Border>
            <Border Background="Transparent" BorderBrush="#1A2636" BorderThickness="0,0,0,1" Padding="11">
              <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="#AEBCCC" LineHeight="17"
                         Text="Grid settings are visual only. Shift-drag snaps objects to the visible column lines."/>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Thumb x:Name="InspectorSplitter" Width="9" HorizontalAlignment="Left" Cursor="SizeWE"
             DragDelta="InspectorSplitter_DragDelta">
        <Thumb.Template>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="#1A2636" BorderThickness="1,0,0,0"/>
          </ControlTemplate>
        </Thumb.Template>
      </Thumb>
      </Grid>
    </Border>

    <!-- ================= VIEWPORT ================= -->
    <Grid>
      <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  Background="#090D15" Focusable="True"
                  SizeChanged="Viewport_SizeChanged"
                  PreviewMouseWheel="Viewport_PreviewMouseWheel">
      <!-- ScrollHost is sized to the canvas (never smaller than the viewport), so
           the scroll range spans only the artboard: when the whole canvas fits at
           the current zoom there is nothing to scroll (no wheel/scrollbars). -->
      <Canvas x:Name="ScrollHost" Background="#090D15">
        <Canvas x:Name="Pasteboard" Width="{Binding PasteboardWidth}" Height="{Binding PasteboardHeight}"
              Background="#090D15"
              MouseLeftButtonDown="Pasteboard_MouseDown"
              MouseMove="Pasteboard_MouseMove"
              MouseLeftButtonUp="Pasteboard_MouseUp"
              MouseLeave="Pasteboard_MouseLeave"
              ContextMenuOpening="Pasteboard_ContextMenuOpening"
              AllowDrop="True" Drop="Pasteboard_Drop" DragOver="Pasteboard_DragOver">
        <Canvas.ContextMenu>
          <ContextMenu>
            <MenuItem x:Name="SaveElementTransparentMenuItem"
                      Header="Save object as image…"
                      Click="SaveElementTransparent_Click" Visibility="Collapsed">
              <MenuItem.Icon>
                <Path Data="M12,3 V11 M8.5,7.5 L12,11 L15.5,7.5 M5,15 H19 M5,15 V19 H19 V15"
                      Stroke="{StaticResource IconBrush}" StrokeThickness="1.7"
                      Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
              </MenuItem.Icon>
            </MenuItem>
            <Separator x:Name="ElementMenuSeparator" Visibility="Collapsed"/>
            <MenuItem x:Name="MergeMenuItem" Header="Merge" Click="Merge_Click" Visibility="Collapsed">
              <MenuItem.Icon>
                <Path Data="M3,3 H21 V21 H3 Z M9,3 V21 M15,3 V21 M3,9 H21 M3,15 H21"
                      Stroke="{StaticResource IconBrush}" StrokeThickness="1.7"
                      Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="CopyStyleMenuItem" Header="Copy style"
                      Click="CopyStyle_Click" Visibility="Collapsed">
              <MenuItem.Icon>
                <Path Data="M8,8 H18 V18 H8 Z M6,6 H16 V8 M6,6 V16 H8"
                      Stroke="{StaticResource IconBrush}" StrokeThickness="1.7"
                      Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="PasteStyleMenuItem" Header="Paste style"
                      Click="PasteStyle_Click" Visibility="Collapsed">
              <MenuItem.Icon>
                <Path Data="M8,5 H16 V19 H8 Z M10,5 V3 H14 V5 M10,10 H14 M10,13 H14"
                      Stroke="{StaticResource IconBrush}" StrokeThickness="1.7"
                      Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="ReplaceBackgroundMenuItem" Header="Replace background with image"
                      Visibility="Collapsed">
              <MenuItem.Icon>
                <Path Data="M3,5 H21 V19 H3 Z M6,15 L10,11 L13,14 L16,10 L21,16"
                      Stroke="{StaticResource IconBrush}" StrokeThickness="1.6"
                      Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
              </MenuItem.Icon>
              <MenuItem x:Name="BackgroundFromProjectMenuItem" Header="From project..."/>
              <MenuItem Header="From computer..." Click="ReplaceBackgroundFromFile_Click"/>
              <Separator/>
              <MenuItem x:Name="RemoveBackgroundImageMenuItem" Header="Remove image"
                        Click="RemoveBackgroundImage_Click"/>
            </MenuItem>
            <MenuItem x:Name="ProjectSettingsMenuItem" Header="Project settings…" Click="ProjectSettings_Click">
              <MenuItem.Icon>
                <Path Data="M4,4 H12 M4,4 V12 M20,20 H12 M20,20 V12"
                      Stroke="{StaticResource IconBrush}" StrokeThickness="1.7"
                      Fill="Transparent" Width="14" Height="14" Stretch="Uniform"/>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="CanvasBgColorMenuItem" Header="Background color…" Click="CanvasBgColor_Click">
              <MenuItem.Icon>
                <Border Width="13" Height="13" CornerRadius="2" BorderThickness="1" BorderBrush="#223248">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#FF5A5A" Offset="0"/>
                      <GradientStop Color="#FFD25A" Offset="0.25"/>
                      <GradientStop Color="#6BE06B" Offset="0.5"/>
                      <GradientStop Color="#5AA8FF" Offset="0.75"/>
                      <GradientStop Color="#B07BFF" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="CanvasTransparentMenuItem" Header="Transparent background" IsCheckable="True" Click="CanvasTransparent_Click">
              <MenuItem.Icon>
                <Border Width="13" Height="13" CornerRadius="2" BorderThickness="1" BorderBrush="#223248">
                  <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
                      <DrawingBrush.Drawing>
                        <DrawingGroup>
                          <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H3 V3 H0 Z M3,3 H6 V6 H3 Z"/>
                          <GeometryDrawing Brush="#9AA8B8" Geometry="M3,0 H6 V3 H3 Z M0,3 H3 V6 H0 Z"/>
                        </DrawingGroup>
                      </DrawingBrush.Drawing>
                    </DrawingBrush>
                  </Border.Background>
                </Border>
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Canvas.ContextMenu>

        <Rectangle x:Name="Artboard"
                   Canvas.Left="{Binding ArtboardX}" Canvas.Top="{Binding ArtboardY}"
                   Width="{Binding ArtboardWidth}" Height="{Binding ArtboardHeight}"
                   Fill="White" Stroke="#8FA3B5" StrokeThickness="1">
          <!-- Cached once: the blurred shadow must NOT re-render every drag frame. -->
          <Rectangle.CacheMode>
            <BitmapCache/>
          </Rectangle.CacheMode>
          <Rectangle.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="22" ShadowDepth="5"/>
          </Rectangle.Effect>
        </Rectangle>

        <ItemsControl x:Name="ElementHost" ItemsSource="{Binding Elements}"
                      Width="{Binding PasteboardWidth}" Height="{Binding PasteboardHeight}"
                      ItemContainerStyle="{StaticResource ElementContainerStyle}">
          <!-- Elements render ONLY on the white canvas; outside parts are clipped (and don't hit-test). -->
          <ItemsControl.Clip>
            <RectangleGeometry Rect="{Binding ArtboardRect}"/>
          </ItemsControl.Clip>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <Canvas Background="Transparent" IsItemsHost="True"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <controls:GuideOverlay x:Name="GuideOverlay"
                               Width="{Binding PasteboardWidth}" Height="{Binding PasteboardHeight}"
                               ArtboardX="{Binding ArtboardX}" ArtboardY="{Binding ArtboardY}"
                               ArtboardWidth="{Binding ArtboardWidth}" ArtboardHeight="{Binding ArtboardHeight}"
                               Selected="{Binding Selected}"
                               Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- Snap guides (Shift while dragging) -->
        <Line x:Name="SnapGuideV" Stroke="#FFB020" StrokeThickness="1" Visibility="Collapsed"
              IsHitTestVisible="False"/>
        <Line x:Name="SnapGuideH" Stroke="#FFB020" StrokeThickness="1" Visibility="Collapsed"
              IsHitTestVisible="False"/>

        <controls:SelectionOverlay x:Name="SelectionAdorner"
                                   Width="{Binding PasteboardWidth}" Height="{Binding PasteboardHeight}"
                                   IsHitTestVisible="False"/>

        <!-- Slice regions layer: all markers (active = cyan, others dim) -->
        <Canvas x:Name="SliceLayer"
                Width="{Binding PasteboardWidth}" Height="{Binding PasteboardHeight}"
                IsHitTestVisible="False"/>

        <Rectangle x:Name="MarqueeVisual" Visibility="Collapsed" IsHitTestVisible="False"
                   Fill="#1A2E9BFF" Stroke="#2E9BFF" StrokeThickness="1" StrokeDashArray="4 3"/>

        <!-- Draw preview: the real shape (fill, border, corner radius) while dragging -->
        <Path x:Name="DrawShapeVisual" Visibility="Collapsed"
              Stroke="#1E6FBF" StrokeThickness="2" StrokeLineJoin="Round"
              Fill="#2E9BFF" IsHitTestVisible="False"/>
        <Path x:Name="PolygonDraftLine" Visibility="Collapsed"
              Stroke="#2E9BFF" StrokeThickness="1.5" StrokeDashArray="4 3"
              Fill="Transparent" IsHitTestVisible="False"/>
        <Path x:Name="PolygonDraftPoints" Visibility="Collapsed"
              Fill="#2E9BFF" Stroke="White" StrokeThickness="1" IsHitTestVisible="False"/>

        <!-- Paintbrush cursor: a ring at the exact brush size -->
        <Ellipse x:Name="BrushCursor" Visibility="Collapsed"
                 Stroke="#2E9BFF" StrokeThickness="1" Fill="Transparent"
                 IsHitTestVisible="False"/>
      </Canvas>
      </Canvas>
    </ScrollViewer>

      <Canvas x:Name="InteractionOverlay" IsHitTestVisible="False">
        <Border x:Name="DrawSizeTip" Visibility="Collapsed"
                Background="#EE0B121B" BorderBrush="#2E9BFF" BorderThickness="1"
                CornerRadius="4" Padding="7,3">
          <TextBlock x:Name="DrawSizeTipText" FontSize="11" FontFamily="Consolas"
                     Foreground="#E6EEF6"/>
        </Border>
      </Canvas>

      <Border x:Name="EmptyState" Visibility="Collapsed" Background="#E6080A11"
              AllowDrop="True" DragOver="EmptyState_DragOver" Drop="EmptyState_Drop">
        <Border Width="390" Padding="26,24" CornerRadius="10"
                Background="#111A27" BorderBrush="#223248" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel>
            <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource AccentBrush}"
                    HorizontalAlignment="Center">
              <Path Data="M6,4 H18 V20 H6 Z M9,8 H15 M9,12 H15 M9,16 H13"
                    Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                    Width="20" Height="20" Stretch="Uniform"/>
            </Border>
            <TextBlock Text="No project open" FontSize="18" FontWeight="Bold"
                       Foreground="#E6EEF6" HorizontalAlignment="Center" Margin="0,14,0,4"/>
            <TextBlock Text="Create a new project, open a project, or paste / drop an image or .yimpact file."
                       Foreground="#8EA0B4" FontSize="11.5" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
              <Button Style="{StaticResource EmptyPrimaryBtn}" Content="New project"
                      Click="NewCanvas_Click"/>
              <Button Style="{StaticResource EmptySecondaryBtn}" Content="Open project"
                      Click="OpenProject_Click" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Tip: Ctrl+V pastes an image, or drop images and .yimpact projects here."
                       Foreground="#6F8094" FontSize="10" TextAlignment="Center" Margin="0,16,0,0"/>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </DockPanel>
</Window>
