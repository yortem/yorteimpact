<Window x:Class="YorteImpact.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="520" SizeToContent="Height"
        Icon="pack://application:,,,/favicon.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#080A11" Foreground="#E6EEF6">
  <Window.Resources>
    <SolidColorBrush x:Key="CardBg" Color="#111A27"/>
    <SolidColorBrush x:Key="CardBorder" Color="#1A2636"/>
    <SolidColorBrush x:Key="Accent" Color="#2E9BFF"/>
    <SolidColorBrush x:Key="Muted" Color="#8EA0B4"/>

    <DrawingBrush x:Key="Checker" TileMode="Tile"
                  Viewport="0,0,10,10" ViewportUnits="Absolute" Stretch="None">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H5 V5 H0 Z M5,5 H10 V10 H5 Z"/>
          <GeometryDrawing Brush="#C9C9C9" Geometry="M5,0 H10 V5 H5 Z M0,5 H5 V10 H0 Z"/>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style x:Key="BgTile" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Padding="13,11" CornerRadius="6"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3E5A7A"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#13243A"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DimensionBox" TargetType="TextBox">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Background" Value="#05080E"/>
      <Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="BorderBrush" Value="#223248"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
    </Style>

    <Style x:Key="TabBtn" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#16202D"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#13243A"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="#E6EEF6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <StackPanel Margin="28,24,28,22">
    <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Width="42" Height="42" CornerRadius="8" Background="#17304F">
        <Path Data="M12,8.5 A3.5,3.5 0 1,1 11.99,8.5 M12,2 V4.5 M12,19.5 V22 M2,12 H4.5 M19.5,12 H22 M4.9,4.9 L6.7,6.7 M17.3,17.3 L19.1,19.1 M19.1,4.9 L17.3,6.7 M6.7,17.3 L4.9,19.1"
              Stroke="{StaticResource Accent}" StrokeThickness="1.6" Fill="Transparent"
              Width="20" Height="20" Stretch="Uniform"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="SETTINGS" FontSize="9" FontWeight="Bold"
                   Foreground="{StaticResource Accent}"/>
        <TextBlock Text="Application preferences" FontWeight="SemiBold" FontSize="17"/>
      </StackPanel>
      <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,5"
              CornerRadius="4" Background="#0D131D" BorderBrush="#1A2636" BorderThickness="1">
        <TextBlock Text="YORTEIMPACT" FontSize="9" FontWeight="SemiBold"
                   Foreground="{StaticResource Muted}"/>
      </Border>
    </Grid>

    <Border Height="1" Background="#1A2636" Margin="0,0,0,16"/>

    <!-- Tabs -->
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <ToggleButton x:Name="GeneralTabBtn" Style="{StaticResource TabBtn}" Content="General"
                    IsChecked="True" Click="GeneralTab_Click"/>
      <ToggleButton x:Name="IntegrationsTabBtn" Style="{StaticResource TabBtn}" Content="Integrations"
                    Click="IntegrationsTab_Click"/>
    </StackPanel>

    <!-- ============ GENERAL TAB ============ -->
    <Grid x:Name="GeneralTab">
    <StackPanel>
      <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
              BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="DEFAULT CANVAS" FontSize="10" FontWeight="Bold"
                     Foreground="{StaticResource Muted}"/>
          <TextBlock Text="Used when the application creates its startup canvas."
                     FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,14"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="20"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Width · pixels" FontSize="10" Foreground="{StaticResource Muted}" Margin="1,0,0,5"/>
              <TextBox x:Name="WidthBox" Text="2000" Style="{StaticResource DimensionBox}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       Margin="0,0,0,9" FontSize="15" Foreground="{StaticResource Muted}"/>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Height · pixels" FontSize="10" Foreground="{StaticResource Muted}" Margin="1,0,0,5"/>
              <TextBox x:Name="HeightBox" Text="2000" Style="{StaticResource DimensionBox}"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
              BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="DEFAULT BACKGROUND" FontSize="10" FontWeight="Bold"
                     Foreground="{StaticResource Muted}"/>
          <TextBlock Text="Choose the starting surface for a new canvas."
                     FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,12"/>
          <UniformGrid Columns="2">
            <RadioButton x:Name="BgWhite" GroupName="Bg" Style="{StaticResource BgTile}" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="24" CornerRadius="3" Background="White"
                        BorderBrush="#223248" BorderThickness="1"/>
                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                  <TextBlock Text="White" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock Text="Opaque canvas" FontSize="10" Foreground="{StaticResource Muted}"/>
                </StackPanel>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="BgTransparent" GroupName="Bg" Style="{StaticResource BgTile}" Margin="8,0,0,0">
              <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="24" CornerRadius="3" Background="{StaticResource Checker}"
                        BorderBrush="#223248" BorderThickness="1"/>
                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                  <TextBlock Text="Transparent" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock Text="Alpha background" FontSize="10" Foreground="{StaticResource Muted}"/>
                </StackPanel>
              </StackPanel>
            </RadioButton>
          </UniformGrid>
        </StackPanel>
      </Border>
    </StackPanel>
    </Grid>

    <!-- ============ INTEGRATIONS TAB ============ -->
    <Grid x:Name="IntegrationsTab" Visibility="Collapsed">
      <StackPanel>
        <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="PIXABAY" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource Muted}"/>
            <TextBlock Text="Photo library for the Elements panel." FontSize="12" Margin="0,5,0,10"/>
            <TextBox x:Name="PixabayKeyBox" FontSize="12" Background="#05080E" Foreground="#E6EEF6"
                     BorderBrush="#223248" BorderThickness="1" Padding="10,8"
                     CaretBrush="{StaticResource Accent}" FontFamily="Consolas"/>
            <TextBlock FontSize="10.5" Foreground="{StaticResource Muted}" Margin="2,8,0,0" TextWrapping="Wrap">
              <Run Text="Photos are provided by Pixabay. Create a free API key at "/>
              <Hyperlink NavigateUri="https://pixabay.com/api/docs/"
                         RequestNavigate="RepositoryLink_RequestNavigate"
                         Foreground="{StaticResource Accent}">pixabay.com/api</Hyperlink>
              <Run Text="."/>
            </TextBlock>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <Border Background="#0D131D" BorderBrush="#1A2636" BorderThickness="1"
            CornerRadius="8" Padding="16,12" Margin="0,16,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="PROJECT REPOSITORY" FontSize="9" FontWeight="Bold"
                     Foreground="{StaticResource Muted}"/>
          <TextBlock FontSize="12" Margin="0,3,0,0">
            <Hyperlink NavigateUri="https://github.com/yortem/yorteimpact"
                       RequestNavigate="RepositoryLink_RequestNavigate"
                       Foreground="{StaticResource Accent}">github.com/yortem/yorteimpact</Hyperlink>
          </TextBlock>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="↗" FontSize="16" Foreground="{StaticResource Muted}"
                   VerticalAlignment="Center" Margin="16,0,0,0"/>
      </Grid>
    </Border>
    <TextBlock x:Name="ErrorText" Foreground="#FF7B7B" Margin="2,12,0,0"
               FontSize="11" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" Width="96" Padding="0,8" Margin="0,0,10,0"
              Background="#111A27" Foreground="#C3CFDC" BorderBrush="#223248" BorderThickness="1"
              Cursor="Hand" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="Save preferences" Width="132" Padding="0,8" IsDefault="True"
              Background="{StaticResource Accent}" Foreground="White" BorderBrush="Transparent"
              FontWeight="SemiBold" Cursor="Hand" Click="Save_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
