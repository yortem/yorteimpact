<Window x:Class="YorteImpact.Controls.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color Picker" Width="472" Height="486"
        Icon="pack://application:,,,/favicon.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Background="#1A1A20" Foreground="#F2F2F5">
  <Window.Resources>
    <Style x:Key="PickLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#A0A0AB"/><Setter Property="FontSize" Value="10"/>
      <Setter Property="Margin" Value="0,8,0,2"/>
    </Style>
    <Style x:Key="PickBox" TargetType="TextBox">
      <Setter Property="Background" Value="#2B2B33"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#3A3A44"/><Setter Property="Padding" Value="5,3"/>
    </Style>
    <Style x:Key="PickBtn" TargetType="Button">
      <Setter Property="Background" Value="#2B2B33"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#3A3A44"/><Setter Property="Padding" Value="16,6"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>

    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#A0A0AB"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd" Background="Transparent" Padding="14,6" Margin="0,0,4,0"
                    CornerRadius="3,3,0,0" BorderThickness="0,0,0,2" BorderBrush="Transparent">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2B2B33"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#4C8DFF"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="#2A3B52" CornerRadius="4" Margin="1,3"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3E5A7A"/>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2E9BFF"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="8"/>
          <Setter Property="MinHeight" Value="8"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent">
                  <Track x:Name="PART_Track" Orientation="Horizontal">
                    <Track.Thumb>
                      <Thumb>
                        <Thumb.Template>
                          <ControlTemplate TargetType="Thumb">
                            <Border x:Name="Bd" Background="#2A3B52" CornerRadius="4" Margin="3,1"/>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E5A7A"/>
                              </Trigger>
                              <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E9BFF"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Thumb.Template>
                      </Thumb>
                    </Track.Thumb>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TabControl Grid.Row="0">

      <!-- ===================== PICKER ===================== -->
      <TabItem Header="PICKER">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="0,10,0,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- Saturation / Value square -->
              <Grid Grid.Column="0" x:Name="SvHost" Width="230" Height="230"
                    MouseLeftButtonDown="Sv_MouseDown" MouseMove="Sv_MouseMove"
                    MouseLeftButtonUp="Sv_MouseUp" Cursor="Cross" Background="Transparent">
                <Rectangle x:Name="SvSquare"/>
                <Rectangle x:Name="SvShade"/>
                <Rectangle Stroke="#3A3A44" StrokeThickness="1" Fill="Transparent" IsHitTestVisible="False"/>
                <Canvas x:Name="SvOverlay" IsHitTestVisible="False">
                  <Ellipse x:Name="Crosshair" Width="13" Height="13" StrokeThickness="2"
                           Stroke="White" Fill="Transparent">
                    <Ellipse.Effect>
                      <DropShadowEffect Color="Black" Opacity="0.9" BlurRadius="3" ShadowDepth="0"/>
                    </Ellipse.Effect>
                  </Ellipse>
                </Canvas>
              </Grid>

              <!-- Hue bar -->
              <Grid Grid.Column="2" x:Name="HueHost" Width="24" Height="230"
                    MouseLeftButtonDown="Hue_MouseDown" MouseMove="Hue_MouseMove"
                    MouseLeftButtonUp="Hue_MouseUp" Cursor="Hand" Background="Transparent">
                <Rectangle x:Name="HueBar"/>
                <Rectangle Stroke="#3A3A44" StrokeThickness="1" Fill="Transparent" IsHitTestVisible="False"/>
                <Canvas x:Name="HueOverlay" IsHitTestVisible="False">
                  <Rectangle x:Name="HueMarker" Width="24" Height="4" Stroke="White" StrokeThickness="1.5"/>
                </Canvas>
              </Grid>

              <!-- Right column: preview, hex, RGB -->
              <StackPanel Grid.Column="4">
                <TextBlock Text="NEW" Style="{StaticResource PickLabel}"/>
                <Border x:Name="PreviewSwatch" Height="34" CornerRadius="3" BorderBrush="#3A3A44" BorderThickness="1"/>

                <TextBlock Text="HEX" Style="{StaticResource PickLabel}"/>
                <TextBox x:Name="HexBox" Style="{StaticResource PickBox}" TextChanged="Hex_TextChanged"/>

                <TextBlock Text="RGB" Style="{StaticResource PickLabel}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="6"/>
                    <ColumnDefinition/><ColumnDefinition Width="6"/>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="RBox" Grid.Column="0" Style="{StaticResource PickBox}" TextChanged="Rgb_TextChanged"/>
                  <TextBox x:Name="GBox" Grid.Column="2" Style="{StaticResource PickBox}" TextChanged="Rgb_TextChanged"/>
                  <TextBox x:Name="BBox" Grid.Column="4" Style="{StaticResource PickBox}" TextChanged="Rgb_TextChanged"/>
                </Grid>

                <Button x:Name="ScreenPickBtn" Style="{StaticResource PickBtn}" Margin="0,12,0,0" Padding="8,5"
                        Click="ScreenPick_Click" ToolTip="Pick a color from anywhere on screen">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Grid Width="14" Height="14" VerticalAlignment="Center">
                      <Path Data="M2.3,12.9 L8.4,6.8" Stroke="#8ED0FF" StrokeThickness="2.8"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                      <Path Data="M8.4,5.1 L10.7,7.4" Stroke="#AEBCCC" StrokeThickness="1.7"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                      <Ellipse Width="4.8" Height="4.8" HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="8.1,0.6,0,0" Fill="#E6EEF6"/>
                    </Grid>
                    <TextBlock Text="Pick from screen" Margin="6,0,0,0" FontSize="10"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <TextBlock Text="SWATCHES" Style="{StaticResource PickLabel}"/>
            <WrapPanel x:Name="PaletteWrap"/>

            <TextBlock Text="FROM IMAGE" Style="{StaticResource PickLabel}"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="PasteImageBtn" Style="{StaticResource PickBtn}" Margin="0" Padding="9,5"
                      Click="PasteImage_Click" ToolTip="Paste an image from the clipboard (Ctrl+V)">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M4,2 H12 V14 H4 Z M7,5 H9 M7,8 H9 M7,11 H9"
                        Stroke="#AEBCCC" StrokeThickness="1.4" Fill="Transparent"
                        Width="12" Height="12" Stretch="Uniform"/>
                  <TextBlock Text="Paste image" Margin="6,0,0,0" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <TextBlock Text="or drop an image here" Foreground="#6A6A74" FontSize="10"
                         VerticalAlignment="Center" Margin="9,0,0,0"/>
            </StackPanel>
            <WrapPanel x:Name="ImageWrap" Margin="0,6,0,0"/>
            <TextBlock x:Name="ImageEmptyHint" Visibility="Collapsed"
                       Text="No image yet - paste or drop one to read its palette."
                       Foreground="#6A6A74" FontSize="10"/>

            <Grid>
              <TextBlock Text="USED ON THIS CANVAS" Style="{StaticResource PickLabel}"/>
              <Button x:Name="CopyPaletteBtn" Content="Copy hex" Padding="7,2" FontSize="9.5"
                      HorizontalAlignment="Right" Margin="0,7,0,0"
                      Background="#2B2B33" Foreground="#C7D6E6" BorderBrush="#3A3A44"
                      Click="CopyPalette_Click" ToolTip="Copy the canvas colors as a hex list"/>
            </Grid>
            <WrapPanel x:Name="CanvasWrap"/>
            <TextBlock x:Name="CanvasEmptyHint" Visibility="Collapsed"
                       Text="No colors on the canvas yet." Foreground="#6A6A74" FontSize="10"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===================== PALETTES ===================== -->
      <TabItem Header="PALETTES">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="0,10,0,0">
          <StackPanel>
            <TextBlock Text="Click any color to load it into the picker."
                       Foreground="#6A6A74" FontSize="10" Margin="0,0,0,10"/>
            <StackPanel x:Name="PalettesHost"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

    <!-- Buttons -->
    <Grid Grid.Row="1" Margin="0,14,0,0">
      <TextBlock x:Name="StatusText" Foreground="#8EA0B4" FontSize="10"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="OkBtn" Style="{StaticResource PickBtn}" Content="OK"
                IsDefault="True" Background="#4C8DFF" BorderBrush="#4C8DFF" Click="Ok_Click"/>
        <Button Style="{StaticResource PickBtn}" Content="Cancel" IsCancel="True"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
