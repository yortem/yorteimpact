<Window x:Class="YorteImpact.NewCanvasDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New canvas" Width="580" SizeToContent="Height"
        Icon="pack://application:,,,/favicon.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#080A11" Foreground="#E6EEF6">
  <Window.Resources>
    <SolidColorBrush x:Key="CardBg" Color="#151F2E"/>
    <SolidColorBrush x:Key="CardBorder" Color="#26364A"/>
    <SolidColorBrush x:Key="Accent" Color="#2E9BFF"/>
    <SolidColorBrush x:Key="Muted" Color="#8EA0B4"/>

    <DrawingBrush x:Key="Checker" TileMode="Tile"
                  Viewport="0,0,10,10" ViewportUnits="Absolute" Stretch="None">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H5 V5 H0 Z M5,5 H10 V10 H5 Z"/>
          <GeometryDrawing Brush="#C9C9C9" Geometry="M5,0 H10 V5 H5 Z M0,5 H5 V10 H0 Z"/>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- segmented category chip -->
    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#B9C8D8"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="2" Padding="14,7"
                    Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1B2A3D"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#14243A"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- format card -->
    <Style x:Key="PresetCard" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Width="128" Padding="12,12" CornerRadius="5"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3E5A7A"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#17304F"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- background tile -->
    <Style x:Key="BgTile" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="Foreground" Value="#E6EEF6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Padding="14,10" CornerRadius="5"
                    Background="{StaticResource CardBg}"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3E5A7A"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#17304F"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <StackPanel Margin="26,22,26,20">
    <!-- header -->
    <StackPanel Orientation="Horizontal">
      <Border Width="38" Height="38" CornerRadius="5" Background="{StaticResource Accent}"
              VerticalAlignment="Center">
        <Path Data="M6,4 H18 V20 H6 Z M9,8 H15 M9,12 H15 M9,16 H13"
              Stroke="White" StrokeThickness="1.6" Fill="Transparent"
              Width="18" Height="18" Stretch="Uniform"/>
      </Border>
      <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="HeaderTitle" Text="New canvas" FontWeight="Bold" FontSize="18"/>
        <TextBlock x:Name="HeaderSubtitle" Text="Choose a size and a background" FontSize="11"
                   Foreground="#AEBCCC"/>
      </StackPanel>
    </StackPanel>

    <Border Height="1" Background="#1A2636" Margin="0,18,0,16"/>

    <!-- category chips (Manual first) -->
    <StackPanel Orientation="Horizontal">
      <RadioButton x:Name="ChipManual" GroupName="Cat" Content="Manual" Tag="Manual"
                   Style="{StaticResource Chip}" Checked="Category_Checked"/>
      <RadioButton x:Name="ChipWeb" GroupName="Cat" Content="Web" Tag="Web"
                   Style="{StaticResource Chip}" Checked="Category_Checked"/>
      <RadioButton x:Name="ChipPaper" GroupName="Cat" Content="Paper" Tag="Paper"
                   Style="{StaticResource Chip}" Checked="Category_Checked"/>
      <RadioButton x:Name="ChipMobile" GroupName="Cat" Content="Mobile" Tag="Mobile"
                   Style="{StaticResource Chip}" Checked="Category_Checked"/>
      <RadioButton x:Name="ChipSocial" GroupName="Cat" Content="Social" Tag="Social"
                   Style="{StaticResource Chip}" Checked="Category_Checked"/>
    </StackPanel>

    <!-- one source of truth: manual px OR preset cards -->
    <Grid Margin="0,16,0,0">
      <Grid x:Name="ManualPanel">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="Canvas size in pixels" Foreground="#AEBCCC"
                     FontSize="11" Margin="2,0,0,8"/>
          <StackPanel Orientation="Horizontal">
            <TextBox x:Name="WidthBox" Text="1200" Width="120" FontSize="15"
                     TextAlignment="Center" Background="#111A27" Foreground="White"
                     BorderBrush="#1A2636" Padding="10,8" TextChanged="Size_TextChanged"/>
            <TextBlock Text="×" VerticalAlignment="Center"
                       FontSize="15" Foreground="{StaticResource Muted}" Margin="10,0"/>
            <TextBox x:Name="HeightBox" Text="800" Width="120" FontSize="15"
                     TextAlignment="Center" Background="#111A27" Foreground="White"
                     BorderBrush="#1A2636" Padding="10,8" TextChanged="Size_TextChanged"/>
          </StackPanel>
        </StackPanel>
        <Grid Grid.Column="1" Width="112" Height="84" Margin="12,0,0,0">
          <Border x:Name="ManualPreview" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Background="#1D4C7E" BorderBrush="#5FBBFF" BorderThickness="1" CornerRadius="2"/>
        </Grid>
      </Grid>

      <StackPanel x:Name="PresetPanel" Visibility="Collapsed">
        <ListBox x:Name="PresetList" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource PresetCard}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 SelectionChanged="PresetList_SelectionChanged">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <Border Height="50" VerticalAlignment="Center" HorizontalAlignment="Center">
                  <Border Width="{Binding ThumbW}" Height="{Binding ThumbH}"
                          CornerRadius="2" BorderBrush="#5FBBFF" BorderThickness="1"
                          Background="#1D4C7E"/>
                </Border>
                <TextBlock Text="{Binding Name}" TextAlignment="Center" FontSize="12.5"
                           FontWeight="SemiBold" Foreground="#F2F7FC" Margin="0,8,0,2"/>
                <TextBlock Text="{Binding SizeText}" TextAlignment="Center" FontSize="10.5"
                           Foreground="#AFC2D4"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Grid>

    <!-- background: white or transparent only -->
    <StackPanel x:Name="BackgroundSection">
      <TextBlock Text="BACKGROUND" Foreground="#AEBCCC" FontSize="10"
                 FontWeight="SemiBold" Margin="2,18,0,8"/>
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="BgWhite" GroupName="Bg" Style="{StaticResource BgTile}">
          <StackPanel Orientation="Horizontal">
            <Border Width="34" Height="24" CornerRadius="2" Background="White"
                    BorderBrush="#223248" BorderThickness="1"/>
            <TextBlock Text="White" VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="BgTransparent" GroupName="Bg" Style="{StaticResource BgTile}">
          <StackPanel Orientation="Horizontal">
            <Border Width="34" Height="24" CornerRadius="2" Background="{StaticResource Checker}"
                    BorderBrush="#223248" BorderThickness="1"/>
            <TextBlock Text="Transparent" VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0"/>
          </StackPanel>
        </RadioButton>
      </StackPanel>
    </StackPanel>

    <TextBlock x:Name="ErrorText" Foreground="#FF7B7B" Margin="2,12,0,0" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Content="Cancel" Width="96" Padding="0,8" Margin="0,0,10,0"
              Background="#223248" Foreground="White" BorderBrush="Transparent"
              Cursor="Hand" Click="Cancel_Click"/>
      <Button x:Name="PrimaryButton" Content="Create" Width="112" Padding="0,8" IsDefault="True"
              Background="{StaticResource Accent}" Foreground="White" BorderBrush="Transparent"
              Cursor="Hand" Click="Create_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
